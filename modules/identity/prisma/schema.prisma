/// MOD-01 Identity, organisations and access.

model User {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  primaryOrgId  String?   @map("primary_org_id") @db.Uuid
  email         String
  displayName   String    @map("display_name")
  idpSubject    String?   @map("idp_subject")
  /// The identity provider's own id for this person, as SCIM sends it. Not
  /// the OIDC subject: Entra sends a different value in each.
  scimExternalId String?  @map("scim_external_id")
  status        String    @default("active")
  managerId     String?   @map("manager_id") @db.Uuid
  locale        String    @default("en-GB")
  timeZone      String    @default("Europe/London") @map("time_zone")
  a11yPrefs     Json      @default("{}") @map("a11y_prefs")
  /// Tenant-visible standing of the person, used by business rules and by the
  /// SLA policy matcher (docs/architecture/11 §1, 12 §1).
  vip           Boolean   @default(false)
  tier          String?
  isExternal    Boolean   @default(false) @map("is_external")
  isBreakGlass  Boolean   @default(false) @map("is_break_glass")
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  version       Int       @default(1)

  memberships     TeamMembership[]
  roleAssignments RoleAssignment[]
  sessions        Session[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, idpSubject])
  @@index([tenantId, managerId])
  @@map("app_user_account")
}

model Team {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  name        String
  key         String
  type        String    @default("support_group")
  emailAlias  String?   @map("email_alias")
  managerId   String?   @map("manager_id") @db.Uuid
  calendarId  String?   @map("calendar_id") @db.Uuid
  /// Set when an identity provider's group owns this team through SCIM.
  scimExternalId String? @map("scim_external_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  members     TeamMembership[]

  @@unique([tenantId, key])
  @@index([tenantId, orgId])
  @@map("team")
}

model TeamMembership {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  teamId     String    @map("team_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleInTeam String    @default("member") @map("role_in_team")
  isLead     Boolean   @default(false) @map("is_lead")
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo    DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([tenantId, userId])
  @@map("team_membership")
}

model Location {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  name       String
  address    String?
  timeZone   String    @default("Europe/London") @map("time_zone")
  calendarId String?   @map("calendar_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  version    Int       @default(1)

  @@index([tenantId, orgId])
  @@map("location")
}

model Role {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid
  version     Int      @default(1)

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, key])
  @@map("role")
}

/// A role is a set of (permission key, scope) pairs. Keys come from the module
/// manifests' permission registry; the seed matrix is Appendix B.
model RolePermission {
  id            String @id @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")
  scope         String @default("own")

  role          Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey, scope])
  @@index([tenantId, permissionKey])
  @@map("role_permission")
}

model RoleAssignment {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  scopeType String?   @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  /// The team (an identity provider's group) whose SCIM role mapping granted
  /// this. Leaving the group revokes it; an assignment made by hand has none.
  viaScimTeamId String? @map("via_scim_team_id") @db.Uuid

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([tenantId, userId])
  @@map("role_assignment")
}

model Session {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sid        String
  device     String?
  ip         String?
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sid])
  @@index([tenantId, userId])
  @@map("session")
}

model ApiKey {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  prefix     String
  hash       String
  scopes     String[]  @default([])
  serviceUserId String @map("service_user_id") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid

  @@unique([tenantId, prefix])
  @@index([tenantId])
  @@map("api_key")
}

model Delegate {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  delegateId  String    @map("delegate_id") @db.Uuid
  capability  String    @default("approve")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo     DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([principalId, delegateId, capability])
  @@index([tenantId, delegateId])
  @@map("delegate")
}

/// The SCIM bearer token, hashed. One current row per tenant; a rotated one
/// keeps an expiry for the overlap; a revoked one keeps the date.
model ScimToken {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  /// The last four characters, so an administrator can tell which is which.
  hint       String
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@unique([tenantId, tokenHash])
  @@index([tenantId, revokedAt])
  @@map("scim_token")
}

/// A provider group's name to a platform role: joining the group grants
/// it, leaving the group revokes it. The tenant's decision, made once.
model ScimRoleMapping {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  groupName String   @map("group_name")
  roleKey   String   @map("role_key")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, groupName, roleKey])
  @@map("scim_role_mapping")
}
