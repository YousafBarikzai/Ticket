/// MOD-14 Integrations, API and developer platform.

/// Written in the same transaction as the change that caused it (ADR-0002).
model OutboxEvent {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String
  version       Int       @default(1)
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  aggregateVersion Int?   @map("aggregate_version")
  envelope      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([createdAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([type])
  @@map("outbox_event")
}

/// A consumer claims an event here before doing work, which is what makes
/// duplicate deliveries (retries, replays, Redis loss) no-ops.
model InboxEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  outcome     String   @default("done")
  error       String?

  @@id([consumer, eventId])
  @@index([tenantId, processedAt])
  @@map("inbox_event")
}

/// Platform table: which consumers exist and which events each requires.
/// Upserted from the module manifests at boot; the reconciler reads it.
model ConsumerRegistry {
  consumer   String   @id
  moduleId   String   @map("module_id")
  eventTypes String[] @map("event_types")
  required   Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("consumer_registry")
}

model WebhookSubscription {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orgId       String?   @map("org_id") @db.Uuid
  name        String
  url         String
  secret      String
  eventTypes  String[]  @map("event_types")
  filters     Json?
  status      String    @default("pending")
  ownerId     String?   @map("owner_id") @db.Uuid
  failureCount Int      @default(0) @map("failure_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int       @default(1)

  deliveries  WebhookDelivery[]

  @@index([tenantId, status])
  @@map("webhook_subscription")
}

model WebhookDelivery {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  attempt        Int       @default(1)
  status         String    @default("pending")
  responseCode   Int?      @map("response_code")
  latencyMs      Int?      @map("latency_ms")
  error          String?
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("webhook_delivery")
}

/// MOD-14-E3 Integration gateway (PH-4).
///
/// Every outbound call a tenant's configuration can cause, recorded so that
/// "the connector stopped working on Tuesday" is answerable. Bodies and headers
/// are redacted before they reach this table: it is read by support, exported
/// with configuration, and kept for as long as retention says.
model IntegrationLog {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  connector      String
  /// outbound | inbound
  direction      String
  method         String
  /// Already stripped of credentials in the userinfo and query string.
  url            String
  requestHeaders Json     @default("{}") @map("request_headers")
  requestBody    Json?    @map("request_body")
  /// 0 when no response was received at all: a timeout, a refusal, a reset.
  status         Int      @default(0)
  responseBody   Json?    @map("response_body")
  durationMs     Int      @default(0) @map("duration_ms")
  error          String?
  correlationId  String?  @map("correlation_id")
  /// What caused the call — a workflow run, a rule, a sync job.
  causeKind      String?  @map("cause_kind")
  causeId        String?  @map("cause_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, connector, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, causeKind, causeId])
  @@map("integration_log")
}

/// A credential the platform stores and later reads back (09 §4).
///
/// Write-only from the API's point of view: the value is never returned after
/// creation, only used. What an operator sees is the fingerprint, which is
/// enough to tell two credentials apart and useless to anybody who steals the
/// table.
model ConnectorCredential {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// The name a connector or channel account refers to it by.
  ref         String
  /// What it is for, so a rotation reminder can say which system breaks.
  kind        String   @default("generic")
  description String?
  /// The sealed value: ciphertext, nonce, tag, and the wrapped data key.
  sealed      Json
  /// Which KEK wrapped it, so a rotation can find what still needs re-wrapping.
  kekVersion  String   @map("kek_version")
  /// The last eight hex characters of the secret's hash. Not reversible.
  fingerprint String
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt   DateTime? @map("rotated_at") @db.Timestamptz(6)
  /// Answers "is this still in use?" before somebody deletes it.
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  @@unique([tenantId, ref])
  @@index([tenantId, kind])
  @@index([tenantId, kekVersion])
  @@map("connector_credential")
}

/// MOD-06-E2 An action a workflow can take on the outside world.
///
/// A named, governed definition rather than a URL typed into a workflow node:
/// the same call is reused by several workflows, its credential is named once,
/// and an administrator can see every outbound call the platform can make by
/// listing this table — which is the question a security review actually asks.
model ActionDefinition {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  key             String
  name            String
  description     String?
  /// http | transform. A closed set; `ticket.*` and `user.*` are the platform's
  /// own services, reached through their modules rather than through here.
  kind            String
  /// Per-kind: for http, the method, URL, headers and body template.
  config          Json     @default("{}")
  /// The credential to attach, by name. Never the credential itself.
  credentialRef   String?  @map("credential_ref")
  /// Which header carries it, because vendors disagree.
  credentialHeader String? @map("credential_header")
  retryMax        Int      @default(3) @map("retry_max")
  timeoutMs       Int      @default(15000) @map("timeout_ms")
  /// Dotted paths from the response into the run context, e.g.
  /// `{ "accountId": "body.data.id" }`.
  responseMapping Json     @default("{}") @map("response_mapping")
  status          String   @default("draft")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("action_definition")
}

/// A side effect that failed past its retries, kept so an operator can see it.
///
/// Separate from the workflow run: an action can fail from a rule, a sync job
/// or a workflow, and "what is broken right now" is one list rather than three
/// places to look.
model ErrorQueueItem {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// workflow | rule | sync
  source      String
  sourceId    String   @map("source_id")
  actionKey   String?  @map("action_key")
  /// What was being attempted, so a replay can repeat it exactly.
  payload     Json     @default("{}")
  /// The idempotency key the original attempt used, and the replay reuses.
  idempotencyKey String @map("idempotency_key")
  error       String
  attempts    Int      @default(1)
  /// open | replayed | dismissed
  status      String   @default("open")
  dismissedReason String? @map("dismissed_reason")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy  String?  @map("resolved_by") @db.Uuid

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, source, sourceId])
  @@map("error_queue_item")
}
