/// MOD-14 Integrations, API and developer platform.

/// Written in the same transaction as the change that caused it (ADR-0002).
model OutboxEvent {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String
  version       Int       @default(1)
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  aggregateVersion Int?   @map("aggregate_version")
  envelope      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([createdAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([type])
  @@map("outbox_event")
}

/// A consumer claims an event here before doing work, which is what makes
/// duplicate deliveries (retries, replays, Redis loss) no-ops.
model InboxEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  outcome     String   @default("done")
  error       String?

  @@id([consumer, eventId])
  @@index([tenantId, processedAt])
  @@map("inbox_event")
}

/// Platform table: which consumers exist and which events each requires.
/// Upserted from the module manifests at boot; the reconciler reads it.
model ConsumerRegistry {
  consumer   String   @id
  moduleId   String   @map("module_id")
  eventTypes String[] @map("event_types")
  required   Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("consumer_registry")
}

model WebhookSubscription {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orgId       String?   @map("org_id") @db.Uuid
  name        String
  url         String
  secret      String
  eventTypes  String[]  @map("event_types")
  filters     Json?
  status      String    @default("pending")
  ownerId     String?   @map("owner_id") @db.Uuid
  failureCount Int      @default(0) @map("failure_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int       @default(1)

  deliveries  WebhookDelivery[]

  @@index([tenantId, status])
  @@map("webhook_subscription")
}

model WebhookDelivery {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  attempt        Int       @default(1)
  status         String    @default("pending")
  responseCode   Int?      @map("response_code")
  latencyMs      Int?      @map("latency_ms")
  error          String?
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("webhook_delivery")
}
