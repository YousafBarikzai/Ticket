/// MOD-11 Notifications, collaboration and communications.

model NotificationTemplate {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  key       String
  channel   String
  locale    String   @default("en-GB")
  subject   String?
  body      String
  bodyFormat String  @default("text") @map("body_format")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, key, channel, locale])
  @@map("notification_template")
}

model NotificationRule {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  key         String
  eventType   String   @map("event_type")
  conditions  Json?
  /// Audience descriptors: requester, assignee, group, watchers, role:<key>.
  audience    Json     @default("[]")
  templateKey String   @map("template_key")
  channels    String[] @default(["inapp"])
  isEmergency Boolean  @default(false) @map("is_emergency")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(1)

  @@unique([tenantId, key])
  @@index([tenantId, eventType, isActive])
  @@map("notification_rule")
}

model Notification {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  eventType   String    @map("event_type")
  recipientId String    @map("recipient_id") @db.Uuid
  ruleKey     String    @map("rule_key")
  templateKey String    @map("template_key")
  ticketId    String?   @map("ticket_id") @db.Uuid
  subject     String?
  body        String
  status      String    @default("queued")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  attempts    DeliveryAttempt[]

  /// One notification per recipient per event per rule: the uniqueness that
  /// makes dispatch idempotent under retries.
  @@unique([eventId, recipientId, ruleKey])
  @@index([tenantId, recipientId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("notification")
}

model DeliveryAttempt {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  channel        String
  attempt        Int       @default(1)
  status         String    @default("pending")
  providerRef    String?   @map("provider_ref")
  error          String?
  attemptedAt    DateTime  @default(now()) @map("attempted_at") @db.Timestamptz(6)

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([tenantId, notificationId])
  @@index([tenantId, status, attemptedAt(sort: Desc)])
  @@map("delivery_attempt")
}

model NotificationPreference {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  channel    String
  enabled    Boolean  @default(true)
  quietHours Json?    @map("quiet_hours")
  digestMode String   @default("immediate") @map("digest_mode")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, channel])
  @@index([tenantId, userId])
  @@map("notification_preference")
}

model DeviceRegistration {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  platform   String
  pushToken  String   @map("push_token")
  appVersion String?  @map("app_version")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, pushToken])
  @@index([tenantId, userId])
  @@map("device_registration")
}
