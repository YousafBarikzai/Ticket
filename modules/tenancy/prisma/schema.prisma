/// MOD-21 Tenancy, licensing and billing.
/// Tenant, TenantDomain, ChannelDirectory, ConsumerRegistry and Plan are
/// PLATFORM tables: they carry no tenant_id because they are what resolves a
/// tenant in the first place. See docs/architecture/05 §2 and 06 §3.

model Tenant {
  id              String    @id @db.Uuid
  name            String
  slug            String    @unique
  status          String    @default("provisioning")
  parentTenantId  String?   @map("parent_tenant_id") @db.Uuid
  region          String    @default("eu-west")
  /// Where this tenant's prompts may be processed. Empty means "wherever this
  /// tenant's own data lives" — the safe reading, and the one that needs no
  /// backfill guess for a tenant provisioned before the policy existed.
  aiAllowedRegions String[] @default([]) @map("ai_allowed_regions")
  planKey         String?   @map("plan_key")
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  domains         TenantDomain[]
  provisioning    TenantProvisioningJob[]

  @@index([status])
  @@map("tenant")
}

model TenantDomain {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  host      String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domain")
}

/// Maps an external channel account (mailbox, workspace, number) to a tenant so
/// an inbound provider webhook can be routed before any tenant context exists.
model ChannelDirectory {
  id         String   @id @db.Uuid
  channel    String
  externalId String   @map("external_id")
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([channel, externalId])
  @@map("channel_directory")
}

model TenantGrant {
  id               String    @id @db.Uuid
  granteeTenantId  String    @map("grantee_tenant_id") @db.Uuid
  targetTenantId   String    @map("target_tenant_id") @db.Uuid
  scope            Json      @default("{}")
  grantedBy        String    @map("granted_by") @db.Uuid
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo          DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([granteeTenantId, targetTenantId])
  @@index([targetTenantId])
  @@map("tenant_grant")
}

model TenantProvisioningJob {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  steps      Json      @default("[]")
  status     String    @default("pending")
  error      String?
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_provisioning_job")
}

/// Organisations are a soft boundary INSIDE a tenant: nested, with a
/// materialised path for subtree queries used by scoped permissions.
model Organisation {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String
  code      String
  type      String    @default("business_unit")
  path      String
  settings  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  @@unique([tenantId, code])
  @@index([tenantId, path])
  @@index([tenantId, parentId])
  @@map("organisation")
}

/// MOD-21 Plans, limits and metering (PH-4).
///
/// A plan is ours, not a tenant's: it has no `tenant_id`, so row-level
/// security has nothing to attach to and every tenant reads the same row.
/// What a tenant may see of it is decided by the service, and what a tenant
/// may change is its own soft thresholds and nothing else (ADR-0038).
model Plan {
  key         String   @id
  name        String
  description String?
  /// Per agent, per month, in micro-pence — the same unit every other amount
  /// in this platform is held in. Null for a plan that is not sold at a list
  /// price: a trial, or an enterprise agreement negotiated per customer.
  /// Nothing in this repository charges anybody; this is what a price *is*,
  /// not a billing integration.
  pricePerAgentMicros BigInt? @map("price_per_agent_micros")
  currency    String   @default("GBP")
  /// Feature flag keys this plan turns on, over the platform defaults.
  features    String[] @default([])
  /// A plan nobody may be moved onto any more, kept for the tenants on it.
  isRetired   Boolean  @default(false) @map("is_retired")
  sortOrder   Int      @default(100) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  limits      PlanLimit[]

  @@map("plan")
}

/// What a plan allows of one meter. `soft` is the line that warns and `hard`
/// the line that refuses; null means no line of that kind.
model PlanLimit {
  id       String  @id @db.Uuid
  planKey  String  @map("plan_key")
  /// agents | tickets | storage | api_calls
  meter    String
  soft     BigInt?
  hard     BigInt?

  plan     Plan    @relation(fields: [planKey], references: [key], onDelete: Cascade)

  @@unique([planKey, meter])
  @@map("plan_limit")
}

/// A tenant's own figure for one meter, and the verdict the request path
/// reads. Recomputed from the source rows nightly, moved by events in
/// between: the same "rollup as a cache of facts" shape MOD-12 uses, for the
/// same reason — an accumulated number nobody can rebuild is a number
/// nobody can defend.
model UsageMeter {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  meter       String
  /// The first day of the period for a counted meter; null for a live one.
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date
  value       BigInt    @default(0)
  /// ok | warned | blocked, as of the last time it moved.
  state       String    @default("ok")
  /// Set once per period per line, so a recompute cannot re-announce one.
  warnedAt    DateTime? @map("warned_at") @db.Timestamptz(6)
  blockedAt   DateTime? @map("blocked_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// PostgreSQL treats NULLs in a unique index as distinct, so a live meter
  /// would never conflict with itself: the period is spelled out instead
  /// (`live`, or `2026-09`), the way MOD-12's grouping key is.
  periodKey   String    @map("period_key")

  @@unique([tenantId, meter, periodKey])
  @@index([tenantId, state])
  @@map("usage_meter")
}

/// A tenant administrator's own warning threshold for one meter. Never a
/// hard one: the hard line is the plan's, and a tenant that could move it
/// would not have a plan.
model TenantLimitOverride {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  meter     String
  soft      BigInt
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, meter])
  @@map("tenant_limit_override")
}
