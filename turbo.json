{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    // No `dependsOn` on purpose. Every workspace in this repository resolves its
    // dependencies from source — each package.json's `main`/`exports` points at
    // `src/index.ts`, never at `dist` — so a typecheck reads its dependencies'
    // TypeScript directly and a prior build produces nothing it consumes.
    // `^build` here cost CI a full build of the graph before a single file was
    // checked, which is what pushed the Validate job past five minutes.
    "typecheck": {},
    "lint": {},
    "test": { "dependsOn": ["^build"] }
  }
}
