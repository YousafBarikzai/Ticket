{
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@itsm/contracts": ["packages/contracts/src/index.ts"],
      "@itsm/platform": ["packages/platform/src/index.ts"],
      "@itsm/expr": ["packages/expr/src/index.ts"],
      "@itsm/business-time": ["packages/business-time/src/index.ts"],
      "@itsm/module-*": ["modules/*/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "modules/**/*.ts", "infra/**/*.ts", "tests/**/*.ts"],
  // `apps/workbench` is excluded and typechecked by its own project instead
  // (`turbo run typecheck`, which CI runs). Its files need the DOM library and
  // Next's `jsx: preserve`, and adding either here would relax the server-side
  // program that everything else is checked in: a worker that reached for
  // `document` would start compiling.
  "exclude": ["node_modules", "**/dist/**", "**/.next/**", "apps/workbench"]
}
