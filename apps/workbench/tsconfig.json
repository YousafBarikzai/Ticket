{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // `preserve` rather than the base's `react-jsx`: Next compiles the JSX
    // itself, and a tsconfig that says otherwise makes its own type plugin
    // disagree with the compiler that actually runs.
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  // `next-env.d.ts` and `.next/types` are generated by a build and are not
  // committed: the first now imports from the second, so a committed copy
  // would reference a directory a clean checkout does not have. Listed here so
  // a developer who has built gets the route types; the typecheck passes
  // without either, which is the case CI runs.
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
