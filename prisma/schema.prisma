// modules/incident/prisma/schema.prisma
// ===========================================================================

/// MOD-08-E1 Major incident management (PH-4).
///
/// An ordinary ticket is one person's problem. A major incident is everybody's,
/// and what makes it different is not severity but *coordination*: somebody has
/// to be in charge, somebody has to keep the organisation informed on a promise
/// it can rely on, and afterwards somebody has to be able to say what happened.
/// Those three things are what this module exists to hold.

/// A declared major incident.
///
/// Declared by a person, never derived. Severity is a judgement about business
/// impact — an outage of a system nobody uses on a Sunday is not a SEV1 whatever
/// the monitoring says, and a platform that guessed would cry wolf until people
/// stopped answering.
model MajorIncident {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  number         String
  /// The ticket it was declared from. Null for one declared directly, which
  /// happens when the outage is noticed before anybody raises a ticket.
  ticketId       String?   @map("ticket_id") @db.Uuid
  title          String
  /// SEV1 widest, SEV3 narrowest. A separate scale from ticket priority on
  /// purpose: priority orders one queue, severity says how much of the
  /// organisation is affected, and conflating them makes both mean less.
  severity       String    @default("SEV2")
  /// declared | identified | mitigating | monitoring | resolved | closed | stood_down
  status         String    @default("declared")
  /// What is broken, for the people who have to be told. Plain language.
  impactSummary  String?   @map("impact_summary")
  /// Service ids this affects, so the status page and the portal can say so.
  affectedServiceIds String[] @default([]) @map("affected_service_ids")
  /// Whether customers outside the organisation can see it. Decides whether a
  /// stakeholder update may leave the building.
  customerFacing Boolean   @default(false) @map("customer_facing")
  /// Where the people fixing it are talking. A link, not a transcript.
  bridgeUrl      String?   @map("bridge_url")

  /// Who is running it. Required from declaration: an incident where everybody
  /// assumed somebody else was in charge is the commonest way an hour is lost.
  commanderId    String    @map("commander_id") @db.Uuid
  /// Who talks to the organisation. Separate from the commander because the
  /// person fixing it should not be the person writing updates.
  commsLeadId    String?   @map("comms_lead_id") @db.Uuid
  /// Who writes down what happened, while it is happening.
  scribeId       String?   @map("scribe_id") @db.Uuid

  /// How often the organisation has been promised an update, in minutes.
  updateIntervalMinutes Int @default(30) @map("update_interval_minutes")
  /// When the next one is owed. Recomputed from the last update rather than
  /// counted down, so a worker that has not run cannot make it look met.
  nextUpdateDueAt DateTime? @map("next_update_due_at") @db.Timestamptz(6)

  declaredAt     DateTime  @default(now()) @map("declared_at") @db.Timestamptz(6)
  declaredBy     String?   @map("declared_by") @db.Uuid
  identifiedAt   DateTime? @map("identified_at") @db.Timestamptz(6)
  mitigatedAt    DateTime? @map("mitigated_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  updates        MajorIncidentUpdate[]
  review         PostIncidentReview?

  @@unique([tenantId, number])
  @@index([tenantId, status, declaredAt(sort: Desc)])
  @@index([tenantId, status, nextUpdateDueAt])
  @@index([tenantId, ticketId])
  @@map("major_incident")
}

/// One entry on the incident's timeline.
///
/// Append-only. The timeline is the evidence a post-incident review is written
/// from, and a timeline somebody can tidy afterwards is not evidence — the
/// question a review has to answer is "what did we know, and when?", and an
/// edited entry cannot answer it.
model MajorIncidentUpdate {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  /// status | comms | action | observation
  kind       String   @default("comms")
  /// internal | stakeholders | public. Audience is access control, not
  /// presentation: an internal note naming a supplier must not reach a status
  /// page because somebody picked the wrong tab.
  audience   String   @default("internal")
  body       String
  /// Set when this entry accompanied a status change, so the timeline shows the
  /// move and the words about it as one thing.
  statusFrom String?  @map("status_from")
  statusTo   String?  @map("status_to")
  authorId   String?  @map("author_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  incident   MajorIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([tenantId, incidentId, occurredAt])
  @@index([tenantId, audience, occurredAt(sort: Desc)])
  @@map("major_incident_update")
}

/// What was learned.
///
/// One per incident, and the thing that decides whether the organisation gets
/// anything back for the hour it lost. Closing an incident without one is the
/// failure this table exists to prevent, which is why closure checks for it
/// rather than trusting anybody to remember.
model PostIncidentReview {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  incidentId         String    @unique @map("incident_id") @db.Uuid
  /// draft | in_review | published
  status             String    @default("draft")
  summary            String?
  /// Deliberately singular and deliberately optional. A review that names one
  /// cause and stops there has usually found the last thing to go wrong rather
  /// than the reason it could.
  rootCause          String?   @map("root_cause")
  contributingFactors String?  @map("contributing_factors")
  whatWentWell       String?   @map("what_went_well")
  whatDidNot         String?   @map("what_did_not")
  /// Minutes from declaration to resolution, frozen at publication so a later
  /// edit to the incident cannot rewrite the record.
  durationMinutes    Int?      @map("duration_minutes")
  dueOn              DateTime? @map("due_on") @db.Date
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy        String?   @map("published_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  incident           MajorIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actions            ActionItem[]

  @@index([tenantId, status, dueOn])
  @@map("post_incident_review")
}

/// Something somebody agreed to do about it.
///
/// Owned by a person with a date, because "we should improve monitoring" owned
/// by nobody is how the same incident happens twice. Converting one into a
/// ticket is a link rather than a copy, so the work is tracked where all other
/// work is tracked.
model ActionItem {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  reviewId    String    @map("review_id") @db.Uuid
  description String
  ownerId     String?   @map("owner_id") @db.Uuid
  dueOn       DateTime? @map("due_on") @db.Date
  /// open | in_progress | done | cancelled
  status      String    @default("open")
  /// The ticket it became, if it became one.
  ticketId    String?   @map("ticket_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  review      PostIncidentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueOn])
  @@index([tenantId, ownerId, status])
  @@map("action_item")
}

// ===========================================================================
// modules/integrations/prisma/schema.prisma
// ===========================================================================

/// MOD-14 Integrations, API and developer platform.

/// Written in the same transaction as the change that caused it (ADR-0002).
model OutboxEvent {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String
  version       Int       @default(1)
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  aggregateVersion Int?   @map("aggregate_version")
  envelope      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([createdAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([type])
  @@map("outbox_event")
}

/// A consumer claims an event here before doing work, which is what makes
/// duplicate deliveries (retries, replays, Redis loss) no-ops.
model InboxEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  outcome     String   @default("done")
  error       String?

  @@id([consumer, eventId])
  @@index([tenantId, processedAt])
  @@map("inbox_event")
}

/// Platform table: which consumers exist and which events each requires.
/// Upserted from the module manifests at boot; the reconciler reads it.
model ConsumerRegistry {
  consumer   String   @id
  moduleId   String   @map("module_id")
  eventTypes String[] @map("event_types")
  required   Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("consumer_registry")
}

model WebhookSubscription {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orgId       String?   @map("org_id") @db.Uuid
  name        String
  url         String
  secret      String
  eventTypes  String[]  @map("event_types")
  filters     Json?
  status      String    @default("pending")
  ownerId     String?   @map("owner_id") @db.Uuid
  failureCount Int      @default(0) @map("failure_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int       @default(1)

  deliveries  WebhookDelivery[]

  @@index([tenantId, status])
  @@map("webhook_subscription")
}

model WebhookDelivery {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  attempt        Int       @default(1)
  status         String    @default("pending")
  responseCode   Int?      @map("response_code")
  latencyMs      Int?      @map("latency_ms")
  error          String?
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("webhook_delivery")
}

/// MOD-14-E3 Integration gateway (PH-4).
///
/// Every outbound call a tenant's configuration can cause, recorded so that
/// "the connector stopped working on Tuesday" is answerable. Bodies and headers
/// are redacted before they reach this table: it is read by support, exported
/// with configuration, and kept for as long as retention says.
model IntegrationLog {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  connector      String
  /// outbound | inbound
  direction      String
  method         String
  /// Already stripped of credentials in the userinfo and query string.
  url            String
  requestHeaders Json     @default("{}") @map("request_headers")
  requestBody    Json?    @map("request_body")
  /// 0 when no response was received at all: a timeout, a refusal, a reset.
  status         Int      @default(0)
  responseBody   Json?    @map("response_body")
  durationMs     Int      @default(0) @map("duration_ms")
  error          String?
  correlationId  String?  @map("correlation_id")
  /// What caused the call — a workflow run, a rule, a sync job.
  causeKind      String?  @map("cause_kind")
  causeId        String?  @map("cause_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, connector, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, causeKind, causeId])
  @@map("integration_log")
}

/// A credential the platform stores and later reads back (09 §4).
///
/// Write-only from the API's point of view: the value is never returned after
/// creation, only used. What an operator sees is the fingerprint, which is
/// enough to tell two credentials apart and useless to anybody who steals the
/// table.
model ConnectorCredential {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// The name a connector or channel account refers to it by.
  ref         String
  /// What it is for, so a rotation reminder can say which system breaks.
  kind        String   @default("generic")
  description String?
  /// The sealed value: ciphertext, nonce, tag, and the wrapped data key.
  sealed      Json
  /// Which KEK wrapped it, so a rotation can find what still needs re-wrapping.
  kekVersion  String   @map("kek_version")
  /// The last eight hex characters of the secret's hash. Not reversible.
  fingerprint String
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt   DateTime? @map("rotated_at") @db.Timestamptz(6)
  /// Answers "is this still in use?" before somebody deletes it.
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  @@unique([tenantId, ref])
  @@index([tenantId, kind])
  @@index([tenantId, kekVersion])
  @@map("connector_credential")
}

/// MOD-06-E2 An action a workflow can take on the outside world.
///
/// A named, governed definition rather than a URL typed into a workflow node:
/// the same call is reused by several workflows, its credential is named once,
/// and an administrator can see every outbound call the platform can make by
/// listing this table — which is the question a security review actually asks.
model ActionDefinition {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  key             String
  name            String
  description     String?
  /// http | transform. A closed set; `ticket.*` and `user.*` are the platform's
  /// own services, reached through their modules rather than through here.
  kind            String
  /// Per-kind: for http, the method, URL, headers and body template.
  config          Json     @default("{}")
  /// The credential to attach, by name. Never the credential itself.
  credentialRef   String?  @map("credential_ref")
  /// Which header carries it, because vendors disagree.
  credentialHeader String? @map("credential_header")
  retryMax        Int      @default(3) @map("retry_max")
  timeoutMs       Int      @default(15000) @map("timeout_ms")
  /// Dotted paths from the response into the run context, e.g.
  /// `{ "accountId": "body.data.id" }`.
  responseMapping Json     @default("{}") @map("response_mapping")
  status          String   @default("draft")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("action_definition")
}

/// A side effect that failed past its retries, kept so an operator can see it.
///
/// Separate from the workflow run: an action can fail from a rule, a sync job
/// or a workflow, and "what is broken right now" is one list rather than three
/// places to look.
model ErrorQueueItem {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// workflow | rule | sync
  source      String
  sourceId    String   @map("source_id")
  actionKey   String?  @map("action_key")
  /// What was being attempted, so a replay can repeat it exactly.
  payload     Json     @default("{}")
  /// The idempotency key the original attempt used, and the replay reuses.
  idempotencyKey String @map("idempotency_key")
  error       String
  attempts    Int      @default(1)
  /// open | replayed | dismissed
  status      String   @default("open")
  dismissedReason String? @map("dismissed_reason")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy  String?  @map("resolved_by") @db.Uuid

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, source, sourceId])
  @@map("error_queue_item")
}

// ===========================================================================
// modules/knowledge/prisma/schema.prisma
// ===========================================================================

/// MOD-09 Knowledge (PH-3).
///
/// An article follows the versioned-definition lifecycle the platform uses for
/// every governed document (docs/architecture/05 §8): edited as a draft,
/// reviewed, published as an immutable version, and rolled back by publishing
/// an earlier version's content forward. What a reader saw last week is
/// therefore still readable, which is the whole point of writing things down.

model KnowledgeArticle {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  title       String
  /// The published version a reader gets. Null until first publication, which
  /// is what makes "published" a property of the article rather than a guess
  /// from the newest version row.
  currentVersionId String? @map("current_version_id") @db.Uuid
  /// draft | in_review | published | retired
  status      String   @default("draft")
  /// Who may read it: internal (agents), tenant (everyone signed in),
  /// organisation (one org's people). Never a presentation choice — the search
  /// ACL is derived from this, and an internal article must not reach a
  /// requester's portal.
  audience    String   @default("internal")
  /// Set when audience is `organisation`.
  orgId       String?  @map("org_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  /// Accountable for the content being correct and current.
  ownerId     String?  @map("owner_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  /// Articles go stale silently; a review date is how that becomes visible.
  reviewDueAt DateTime? @map("review_due_at") @db.Timestamptz(6)
  keywords    String[] @default([])
  viewCount    Int     @default(0) @map("view_count")
  helpfulCount Int     @default(0) @map("helpful_count")
  unhelpfulCount Int   @default(0) @map("unhelpful_count")
  /// How many tickets this article is recorded as having prevented.
  deflectionCount Int  @default(0) @map("deflection_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)

  versions    KnowledgeArticleVersion[]
  feedback    KnowledgeFeedback[]
  links       KnowledgeTicketLink[]

  @@unique([tenantId, key])
  @@index([tenantId, status, updatedAt(sort: Desc)])
  @@index([tenantId, categoryId])
  @@index([tenantId, reviewDueAt])
  @@map("knowledge_article")
}

/// One immutable published version, plus the working draft.
model KnowledgeArticleVersion {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  version    Int
  title      String
  /// One-paragraph answer, shown in search results and on the portal tile.
  summary    String?
  /// The article itself, as rich blocks (packages/contracts RichBlock[]).
  body       Json     @default("[]")
  /// Why this version differs from the last: the thing a reviewer reads first.
  changeNote String?  @map("change_note")
  status     String   @default("draft")
  authorId   String?  @map("author_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy String? @map("published_by") @db.Uuid

  article    KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, articleId, version])
  @@index([tenantId, articleId, version(sort: Desc)])
  @@map("knowledge_article_version")
}

/// Did this answer the question? One vote per person per article.
model KnowledgeFeedback {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  versionId String?  @map("version_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, articleId, userId])
  @@index([tenantId, articleId, createdAt(sort: Desc)])
  @@map("knowledge_feedback")
}

/// An article cited on a ticket: the honest measure of whether knowledge works.
model KnowledgeTicketLink {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  /// `resolved` — this article closed the ticket; `referenced` — it was used.
  relation  String   @default("referenced")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, articleId, ticketId])
  @@index([tenantId, ticketId])
  @@map("knowledge_ticket_link")
}

model KnowledgeCategory {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  /// Materialised path, so a subtree is a prefix match rather than a recursion.
  path      String
  sortOrder Int      @default(100) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([tenantId, path])
  @@map("knowledge_category")
}

