/// MOD-04 Ticket and interaction core — the system of record.

model Ticket {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  orgId          String?   @map("org_id") @db.Uuid
  number         String
  type           String
  title          String
  description    String?
  descriptionFormat String @default("text") @map("description_format")
  status         String
  statusCategory String    @map("status_category")
  priority       String    @default("P3")
  impact         String?
  urgency        String?
  requesterId    String?   @map("requester_id") @db.Uuid
  affectedUserId String?   @map("affected_user_id") @db.Uuid
  assigneeId     String?   @map("assignee_id") @db.Uuid
  groupId        String?   @map("group_id") @db.Uuid
  serviceId      String?   @map("service_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  sourceChannel  String    @default("api") @map("source_channel")
  channelRef     String?   @map("channel_ref")
  parentId       String?   @map("parent_id") @db.Uuid
  slaPolicyId    String?   @map("sla_policy_id") @db.Uuid
  dueAt          DateTime? @map("due_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  reopenCount    Int       @default(0) @map("reopen_count")
  mergedIntoId   String?   @map("merged_into_id") @db.Uuid
  externalRef    String?   @map("external_ref")
  custom         Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdByType  String    @default("user") @map("created_by_type")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  comments    TicketComment[]
  events      TicketEvent[]
  tasks       TicketTask[]
  attachments Attachment[]
  watchers    TicketWatcher[]
  tags        TicketTag[]

  @@unique([tenantId, number])
  @@index([tenantId, statusCategory, priority, dueAt])
  @@index([tenantId, assigneeId, statusCategory])
  @@index([tenantId, groupId, statusCategory, createdAt(sort: Desc)])
  @@index([tenantId, requesterId, createdAt(sort: Desc)])
  @@index([tenantId, serviceId, createdAt(sort: Desc)])
  @@index([tenantId, type, statusCategory])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("ticket")
}

model TicketComment {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  authorId   String?   @map("author_id") @db.Uuid
  authorType String    @default("user") @map("author_type")
  visibility String    @default("public")
  body       String
  bodyFormat String    @default("text") @map("body_format")
  channel    String    @default("api")
  externalRef String?  @map("external_ref")
  quotedBody String?   @map("quoted_body")
  editedAt   DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  version    Int       @default(1)

  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, visibility])
  @@map("ticket_comment")
}

/// Structured timeline entries: status changes, assignments, SLA events,
/// automation. Distinct from comments, which are conversation.
model TicketEvent {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  type       String
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  payload    Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, occurredAt])
  @@map("ticket_event")
}

model Attachment {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  ticketId     String    @map("ticket_id") @db.Uuid
  commentId    String?   @map("comment_id") @db.Uuid
  objectKey    String    @map("object_key")
  filename     String
  mime         String
  size         Int
  scanStatus   String    @default("pending") @map("scan_status")
  scanVerdict  String?   @map("scan_verdict")
  scannedAt    DateTime? @map("scanned_at") @db.Timestamptz(6)
  classification String  @default("internal")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId])
  @@index([tenantId, scanStatus])
  @@map("attachment")
}

model TicketTask {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  ticketId    String    @map("ticket_id") @db.Uuid
  key         String?
  title       String
  description String?
  status      String    @default("open")
  assigneeId  String?   @map("assignee_id") @db.Uuid
  groupId     String?   @map("group_id") @db.Uuid
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  order       Int       @default(0)
  blockedBy   String[]  @default([]) @map("blocked_by")
  visibility  String    @default("internal")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int       @default(1)

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, order])
  @@index([tenantId, assigneeId, status])
  @@map("ticket_task")
}

model TicketLink {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  linkType  String   @map("link_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([sourceId, targetId, linkType])
  @@index([tenantId, targetId])
  @@map("ticket_link")
}

/// Free-form labels. A table rather than an array column so that a tag can be
/// renamed, counted and indexed, and so the rules engine adding one is an
/// ordinary insert rather than a read-modify-write race on a JSON column.
model TicketTag {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  tag       String
  addedBy   String?  @map("added_by") @db.Uuid
  addedByType String @default("user") @map("added_by_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, tag])
  @@index([tenantId, tag])
  @@map("ticket_tag")
}

model TicketWatcher {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reason    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([tenantId, userId])
  @@map("ticket_watcher")
}

model SavedView {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  query     Json     @default("{}")
  isShared  Boolean  @default(false) @map("is_shared")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  @@index([tenantId, ownerId])
  @@map("saved_view")
}

model Category {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  orgId          String?   @map("org_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  key            String
  path           String
  defaultGroupId String?   @map("default_group_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  @@unique([tenantId, key])
  @@index([tenantId, path])
  @@map("category")
}

/// Custom fields (PH-2 feature flag `ticket.customFields`), defined in PH-1 so
/// the ticket API validates `custom` against them from the start.
model FieldDefinition {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  orgId        String?   @map("org_id") @db.Uuid
  key          String
  label        String
  type         String
  options      Json      @default("[]")
  appliesTo    Json      @default("{}") @map("applies_to")
  requiredWhen Json?     @map("required_when")
  visibleTo    String[]  @default([]) @map("visible_to")
  classification String  @default("internal")
  order        Int       @default(0)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int       @default(1)

  @@unique([tenantId, key])
  @@map("field_definition")
}

/// Per-tenant, per-type sequence for human-readable numbers. Incremented inside
/// the creating transaction so a rollback leaves no gap (ADR-0020).
model TicketCounter {
  tenantId String @map("tenant_id") @db.Uuid
  type     String
  next     Int    @default(1)

  @@id([tenantId, type])
  @@map("ticket_counter")
}

// ===========================================================================
// modules/workflow/prisma/schema.prisma
// ===========================================================================

/// MOD-06-E1 Workflow engine (PH-3), per ADR-0009 and docs/architecture/11 §2–3.
///
/// The run tables are the engine's memory. Everything about exactly-once
/// execution rests on `wf_step_run`: a step is claimed by inserting a row, and
/// the unique constraint on (run, step, attempt) is what stops two workers
/// running the same step. Losing Redis loses scheduling, not state.

model WorkflowDefinition {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  /// The version runs start on. Null until first publication.
  currentVersionId String? @map("current_version_id") @db.Uuid
  status      String   @default("draft")
  ownerId     String?  @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions    WorkflowVersion[]
  runs        WorkflowRun[]

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("wf_definition")
}

/// One immutable published graph. A run finishes on the version it started on,
/// so publishing a change never rewrites what is already in flight.
model WorkflowVersion {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  version      Int
  /// The graph: trigger, nodes, edges (docs/architecture/11 §2).
  graph        Json
  status       String   @default("draft")
  changeNote   String?  @map("change_note")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy  String?  @map("published_by") @db.Uuid

  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  runs         WorkflowRun[]

  @@unique([tenantId, definitionId, version])
  @@map("wf_version")
}

model WorkflowRun {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  versionId    String   @map("version_id") @db.Uuid
  ticketId     String?  @map("ticket_id") @db.Uuid
  /// queued | running | waiting | failed | completed | cancelled
  status       String   @default("queued")
  /// Everything `{{path}}` and conditions read: trigger payload, ticket facts,
  /// and each completed node's output under its key.
  context      Json     @default("{}")
  /// The nodes due to run next. An array because PH-4 adds parallel branches;
  /// a single column would have to be migrated rather than extended.
  currentKeys  String[] @default([]) @map("current_keys")
  /// Why a run started, for the question "what set this off?".
  triggeredBy  String?  @map("triggered_by")
  error        String?
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)

  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  steps        WorkflowStepRun[]
  waits        WorkflowWait[]

  @@index([tenantId, status, startedAt(sort: Desc)])
  @@index([tenantId, ticketId])
  @@map("wf_run")
}

/// One attempt at one node.
///
/// The unique constraint is the concurrency control: claiming a step means
/// inserting this row, and a second worker trying the same step fails the
/// constraint and stops. Nothing else is needed, and nothing else is trusted.
model WorkflowStepRun {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  stepKey   String   @map("step_key")
  attempt   Int      @default(1)
  /// started | done | failed | skipped
  status    String   @default("started")
  input     Json     @default("{}")
  output    Json     @default("{}")
  /// Stable across attempts on purpose: a retry after a crash mid-effect must
  /// deduplicate against the effect the crashed attempt may already have had.
  idempotencyKey String @map("idempotency_key")
  error     String?
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([tenantId, runId, stepKey, attempt])
  @@index([tenantId, runId, startedAt])
  @@index([tenantId, status])
  @@map("wf_step_run")
}

/// A run parked on a timer or an event.
///
/// In PostgreSQL rather than only as a delayed job: Redis is a scheduler, not a
/// system of record, and a run that disappears because a queue was flushed is
/// the failure people never forgive an automation engine for.
model WorkflowWait {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  stepKey     String   @map("step_key")
  /// timer | event
  kind        String
  eventType   String?  @map("event_type")
  /// Expression matched against the event payload, so one wait is not woken by
  /// another ticket's event.
  eventFilter Json?    @map("event_filter")
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  /// Where to go if the timeout fires before the event.
  onTimeoutKey String? @map("on_timeout_key")
  status      String   @default("waiting")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([tenantId, runId, stepKey])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, status, eventType])
  @@map("wf_wait")
}

// ===========================================================================
// modules/workload/prisma/schema.prisma
// ===========================================================================

/// MOD-20 Workload and routing (PH-4).
///
/// Answers one question the rest of the platform keeps asking and could not
/// answer until now: *who should do this?* Everything here exists to make that
/// answer defensible — who is working, what they can do, how much they already
/// have, and who is on call when nobody is working.

/// Whether an agent is available, and why not.
///
/// A reason rather than a boolean, because "not available" is not one state:
/// somebody on holiday will be back on a known date, somebody at lunch will be
/// back within the hour, and somebody who has left is never coming back. A
/// router that cannot tell them apart either holds work for a departed
/// employee or reassigns a ticket somebody is actively working on.
model AgentAvailability {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// available | busy | away | off_shift | left
  status    String   @default("available")
  reason    String?
  /// When they expect to be back. Null means indefinite, which routing reads
  /// as "do not queue work for this person".
  until     DateTime? @db.Timestamptz(6)
  /// Set by the person, by a shift, or by the platform noticing they are gone.
  source    String   @default("manual")
  /// How much work they will hold at once. Null means the team default.
  capacity  Int?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("agent_availability")
}

/// A repeating pattern of when a team works.
///
/// Stored as local wall-clock times against a time zone rather than as UTC
/// instants, because "the early shift starts at 07:00" stays true across a
/// daylight-saving change and an instant does not. `packages/business-time`
/// does the conversion, so the rule lives in one place.
model Shift {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  key        String
  name       String
  timeZone   String   @map("time_zone")
  /// Weekday keys to local start/end times: `{ "mon": [{ "from": "07:00", "to": "15:00" }] }`.
  pattern    Json
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments ShiftAssignment[]

  @@unique([tenantId, key])
  @@index([tenantId, teamId, status])
  @@map("shift")
}

/// Who works a shift, over what dates.
model ShiftAssignment {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  shiftId   String   @map("shift_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  startsOn  DateTime @map("starts_on") @db.Date
  /// Null means open-ended, which is the common case for a permanent rota.
  endsOn    DateTime? @map("ends_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shiftId, userId, startsOn])
  @@index([tenantId, userId])
  @@map("shift_assignment")
}

/// Who answers when nobody is at work.
model OnCallRotation {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  key        String
  name       String
  timeZone   String   @map("time_zone")
  /// daily | weekly
  cadence    String   @default("weekly")
  /// When the first period began; every later period is counted from here, so
  /// the rotation is a function of time rather than a cursor that can drift.
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  /// The order people take it, by user id. Rotating the list rotates the rota.
  members    String[] @default([])
  /// Local time of day the handover happens.
  handoverAt String   @default("09:00") @map("handover_at")
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  overrides  OnCallOverride[]

  @@unique([tenantId, key])
  @@index([tenantId, teamId, status])
  @@map("oncall_rotation")
}

/// Somebody covering for somebody else.
///
/// Separate from the rotation rather than an edit to it, because a swap is a
/// fact about one week and the rota is a fact about every week. Editing the
/// member list to cover a holiday shifts everybody's turn for ever.
model OnCallOverride {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  rotationId String   @map("rotation_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6)
  reason     String?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rotation   OnCallRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)

  @@index([tenantId, rotationId, startsAt])
  @@map("oncall_override")
}

/// Something an agent can do.
model Skill {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agents      AgentSkill[]

  @@unique([tenantId, key])
  @@map("skill")
}

/// How well one agent can do it.
model AgentSkill {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  skillId  String @map("skill_id") @db.Uuid
  /// 1 learning, 2 competent, 3 expert. Deliberately coarse: a finer scale
  /// invites an accuracy nobody maintains.
  level    Int    @default(2)

  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, skillId])
  @@index([tenantId, skillId, level])
  @@map("agent_skill")
}

/// How a team wants its work distributed.
model RoutingPolicy {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  /// round_robin | least_loaded | skill
  strategy      String   @default("least_loaded")
  /// What counts as full. A router that ignores this queues work on somebody
  /// who already has more than they can do, which is how a queue becomes a
  /// person's personal backlog.
  defaultCapacity Int    @default(10) @map("default_capacity")
  /// Required skills are matched against the ticket's category when set.
  requireSkill  Boolean  @default(false) @map("require_skill")
  /// Whether a ticket may be assigned to somebody who is off shift.
  allowOffShift Boolean  @default(false) @map("allow_off_shift")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, teamId])
  @@map("routing_policy")
}

/// When each agent was last given a ticket.
///
/// Round robin is derived from this rather than from a stored "whose turn is
/// it next" cursor, for the same reason the on-call rota is: a cursor that is
/// missed, replayed or processed twice drifts, and nobody notices until one
/// person has had three in a row. A mark written late merely delays somebody's
/// turn by one ticket, which is the failure worth having.
model AgentRoutingMark {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastAssignedAt DateTime @map("last_assigned_at") @db.Timestamptz(6)
  /// How many the router has given them, for a fairness report that does not
  /// require reading the whole ticket table.
  assignedCount  Int      @default(0) @map("assigned_count")

  @@unique([tenantId, userId])
  @@map("agent_routing_mark")
}

