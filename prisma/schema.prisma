// modules/security/prisma/schema.prisma
// ===========================================================================

/// MOD-15 Security, privacy, audit and resilience.

/// Append-only and hash-chained per tenant (ADR-0014). The application database
/// role is granted INSERT and SELECT only; there is no UPDATE or DELETE grant.
model AuditEvent {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  seq           BigInt   @default(autoincrement())
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id") @db.Uuid
  onBehalfOf    String?  @map("on_behalf_of") @db.Uuid
  granteeTenantId String? @map("grantee_tenant_id") @db.Uuid
  action        String
  targetType    String   @map("target_type")
  targetId      String?  @map("target_id")
  before        Json?
  after         Json?
  reason        String?
  correlationId String   @map("correlation_id")
  ip            String?
  userAgent     String?  @map("user_agent")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  hash          String
  prevHash      String?  @map("prev_hash")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, actorId])
  @@index([tenantId, action])
  @@index([tenantId, seq])
  @@map("audit_event")
}

model SecurityAlert {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  type      String
  severity  String    @default("medium")
  details   Json      @default("{}")
  status    String    @default("open")
  ticketId  String?   @map("ticket_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("security_alert")
}

/// Field-level classification drives masking in serialisers, redaction in logs
/// and audit, and exclusion from AI context.
model DataClassification {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  entity       String
  field        String
  level        String   @default("internal")
  maskingRule  String?  @map("masking_rule")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, entity, field])
  @@map("data_classification")
}

model RetentionPolicy {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  recordType      String   @map("record_type")
  keepDays        Int      @map("keep_days")
  action          String   @default("delete")
  legalHoldExempt Boolean  @default(false) @map("legal_hold_exempt")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, recordType])
  @@map("retention_policy")
}

// ===========================================================================
// modules/sla/prisma/schema.prisma
// ===========================================================================

/// MOD-07 SLA, OLA and entitlement management (PH-1 slice: the timer engine).

model BusinessCalendar {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  key       String
  name      String
  timeZone  String   @map("time_zone")
  hours     Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  exceptions CalendarException[]

  @@unique([tenantId, key])
  @@map("business_calendar")
}

model CalendarException {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  calendarId String   @map("calendar_id") @db.Uuid
  date       String
  type       String   @default("holiday")
  hours      Json?
  name       String?

  calendar   BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([tenantId])
  @@map("calendar_exception")
}

model SlaPolicy {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  orgId        String?  @map("org_id") @db.Uuid
  key          String
  name         String
  /// Expression matched against the ticket; the most specific match wins.
  match        Json     @default("{\"always\":true}")
  specificity  Int      @default(0)
  calendarMode String   @default("group") @map("calendar_mode")
  calendarId   String?  @map("calendar_id") @db.Uuid
  status       String   @default("published")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  targets      SlaTarget[]
  escalations  EscalationRule[]

  @@unique([tenantId, key])
  @@index([tenantId, status, specificity(sort: Desc)])
  @@map("sla_policy")
}

model SlaTarget {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  policyId          String   @map("policy_id") @db.Uuid
  priority          String
  targetType        String   @map("target_type")
  minutes           Int
  warningThresholds Int[]    @default([50, 75, 90]) @map("warning_thresholds")

  policy            SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, priority, targetType])
  @@index([tenantId])
  @@map("sla_target")
}

model SlaTimer {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  ticketId      String    @map("ticket_id") @db.Uuid
  taskId        String?   @map("task_id") @db.Uuid
  targetType    String    @map("target_type")
  policyId      String    @map("policy_id") @db.Uuid
  policyVersion Int       @map("policy_version")
  calendarId    String?   @map("calendar_id") @db.Uuid
  targetMs      Int       @map("target_ms")
  startedAt     DateTime  @map("started_at") @db.Timestamptz(6)
  dueAt         DateTime? @map("due_at") @db.Timestamptz(6)
  pausedAt      DateTime? @map("paused_at") @db.Timestamptz(6)
  lastResumedAt DateTime? @map("last_resumed_at") @db.Timestamptz(6)
  elapsedMs     Int       @default(0) @map("elapsed_ms")
  remainingMs   Int       @map("remaining_ms")
  state         String    @default("running")
  warningsFired Int[]     @default([]) @map("warnings_fired")
  nextWarningAt DateTime? @map("next_warning_at") @db.Timestamptz(6)
  metAt         DateTime? @map("met_at") @db.Timestamptz(6)
  breachedAt    DateTime? @map("breached_at") @db.Timestamptz(6)
  /// hash(ticket_id) % 16: the scheduler scans one partition per tick job.
  partition     Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int       @default(1)

  pauses        SlaPause[]

  @@unique([tenantId, ticketId, targetType])
  @@index([tenantId, ticketId])
  @@index([state, partition, dueAt])
  @@map("sla_timer")
}

model SlaPause {
  id       String    @id @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  timerId  String    @map("timer_id") @db.Uuid
  reason   String
  from     DateTime  @db.Timestamptz(6)
  to       DateTime? @db.Timestamptz(6)

  timer    SlaTimer  @relation(fields: [timerId], references: [id], onDelete: Cascade)

  @@index([tenantId, timerId])
  @@map("sla_pause")
}

model PriorityMatrix {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  orgId    String? @map("org_id") @db.Uuid
  impact   String
  urgency  String
  priority String

  @@unique([tenantId, orgId, impact, urgency])
  @@map("priority_matrix")
}

model EscalationRule {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  policyId String @map("policy_id") @db.Uuid
  on       String
  step     Int    @default(1)
  notify   Json   @default("{}")
  action   Json?

  policy   SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId, policyId])
  @@map("escalation_rule")
}

model BreachRecord {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  timerId      String    @unique @map("timer_id") @db.Uuid
  ticketId     String    @map("ticket_id") @db.Uuid
  breachedAt   DateTime  @map("breached_at") @db.Timestamptz(6)
  reasonCode   String?   @map("reason_code")
  excusedBy    String?   @map("excused_by") @db.Uuid
  excuseReason String?   @map("excuse_reason")
  excusedAt    DateTime? @map("excused_at") @db.Timestamptz(6)

  @@index([tenantId, breachedAt(sort: Desc)])
  @@map("breach_record")
}

// ===========================================================================
// modules/tenancy/prisma/schema.prisma
// ===========================================================================

/// MOD-21 Tenancy, licensing and billing.
/// Tenant, TenantDomain, ChannelDirectory, ConsumerRegistry and Plan are
/// PLATFORM tables: they carry no tenant_id because they are what resolves a
/// tenant in the first place. See docs/architecture/05 §2 and 06 §3.

model Tenant {
  id              String    @id @db.Uuid
  name            String
  slug            String    @unique
  status          String    @default("provisioning")
  parentTenantId  String?   @map("parent_tenant_id") @db.Uuid
  region          String    @default("eu-west")
  planKey         String?   @map("plan_key")
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  domains         TenantDomain[]
  provisioning    TenantProvisioningJob[]

  @@index([status])
  @@map("tenant")
}

model TenantDomain {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  host      String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domain")
}

/// Maps an external channel account (mailbox, workspace, number) to a tenant so
/// an inbound provider webhook can be routed before any tenant context exists.
model ChannelDirectory {
  id         String   @id @db.Uuid
  channel    String
  externalId String   @map("external_id")
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([channel, externalId])
  @@map("channel_directory")
}

model TenantGrant {
  id               String    @id @db.Uuid
  granteeTenantId  String    @map("grantee_tenant_id") @db.Uuid
  targetTenantId   String    @map("target_tenant_id") @db.Uuid
  scope            Json      @default("{}")
  grantedBy        String    @map("granted_by") @db.Uuid
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo          DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([granteeTenantId, targetTenantId])
  @@index([targetTenantId])
  @@map("tenant_grant")
}

model TenantProvisioningJob {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  steps      Json      @default("[]")
  status     String    @default("pending")
  error      String?
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_provisioning_job")
}

/// Organisations are a soft boundary INSIDE a tenant: nested, with a
/// materialised path for subtree queries used by scoped permissions.
model Organisation {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String
  code      String
  type      String    @default("business_unit")
  path      String
  settings  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  @@unique([tenantId, code])
  @@index([tenantId, path])
  @@index([tenantId, parentId])
  @@map("organisation")
}

// ===========================================================================
