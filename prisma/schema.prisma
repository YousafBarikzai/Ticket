// modules/sla/prisma/schema.prisma
// ===========================================================================

/// MOD-07 SLA, OLA and entitlement management (PH-1 slice: the timer engine).

model BusinessCalendar {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  key       String
  name      String
  timeZone  String   @map("time_zone")
  hours     Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  exceptions CalendarException[]

  @@unique([tenantId, key])
  @@map("business_calendar")
}

model CalendarException {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  calendarId String   @map("calendar_id") @db.Uuid
  date       String
  type       String   @default("holiday")
  hours      Json?
  name       String?

  calendar   BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([tenantId])
  @@map("calendar_exception")
}

model SlaPolicy {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  orgId        String?  @map("org_id") @db.Uuid
  key          String
  name         String
  /// Expression matched against the ticket; the most specific match wins.
  match        Json     @default("{\"always\":true}")
  specificity  Int      @default(0)
  calendarMode String   @default("group") @map("calendar_mode")
  calendarId   String?  @map("calendar_id") @db.Uuid
  status       String   @default("published")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  targets      SlaTarget[]
  escalations  EscalationRule[]

  @@unique([tenantId, key])
  @@index([tenantId, status, specificity(sort: Desc)])
  @@map("sla_policy")
}

model SlaTarget {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  policyId          String   @map("policy_id") @db.Uuid
  priority          String
  targetType        String   @map("target_type")
  minutes           Int
  warningThresholds Int[]    @default([50, 75, 90]) @map("warning_thresholds")

  policy            SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, priority, targetType])
  @@index([tenantId])
  @@map("sla_target")
}

model SlaTimer {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  ticketId      String    @map("ticket_id") @db.Uuid
  taskId        String?   @map("task_id") @db.Uuid
  targetType    String    @map("target_type")
  policyId      String    @map("policy_id") @db.Uuid
  policyVersion Int       @map("policy_version")
  calendarId    String?   @map("calendar_id") @db.Uuid
  targetMs      Int       @map("target_ms")
  startedAt     DateTime  @map("started_at") @db.Timestamptz(6)
  dueAt         DateTime? @map("due_at") @db.Timestamptz(6)
  pausedAt      DateTime? @map("paused_at") @db.Timestamptz(6)
  lastResumedAt DateTime? @map("last_resumed_at") @db.Timestamptz(6)
  elapsedMs     Int       @default(0) @map("elapsed_ms")
  remainingMs   Int       @map("remaining_ms")
  state         String    @default("running")
  warningsFired Int[]     @default([]) @map("warnings_fired")
  nextWarningAt DateTime? @map("next_warning_at") @db.Timestamptz(6)
  metAt         DateTime? @map("met_at") @db.Timestamptz(6)
  breachedAt    DateTime? @map("breached_at") @db.Timestamptz(6)
  /// hash(ticket_id) % 16: the scheduler scans one partition per tick job.
  partition     Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int       @default(1)

  pauses        SlaPause[]

  @@unique([tenantId, ticketId, targetType])
  @@index([tenantId, ticketId])
  @@index([state, partition, dueAt])
  @@map("sla_timer")
}

model SlaPause {
  id       String    @id @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  timerId  String    @map("timer_id") @db.Uuid
  reason   String
  from     DateTime  @db.Timestamptz(6)
  to       DateTime? @db.Timestamptz(6)

  timer    SlaTimer  @relation(fields: [timerId], references: [id], onDelete: Cascade)

  @@index([tenantId, timerId])
  @@map("sla_pause")
}

model PriorityMatrix {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  orgId    String? @map("org_id") @db.Uuid
  impact   String
  urgency  String
  priority String

  @@unique([tenantId, orgId, impact, urgency])
  @@map("priority_matrix")
}

model EscalationRule {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  policyId String @map("policy_id") @db.Uuid
  on       String
  step     Int    @default(1)
  notify   Json   @default("{}")
  action   Json?

  policy   SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId, policyId])
  @@map("escalation_rule")
}

model BreachRecord {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  timerId      String    @unique @map("timer_id") @db.Uuid
  ticketId     String    @map("ticket_id") @db.Uuid
  breachedAt   DateTime  @map("breached_at") @db.Timestamptz(6)
  reasonCode   String?   @map("reason_code")
  excusedBy    String?   @map("excused_by") @db.Uuid
  excuseReason String?   @map("excuse_reason")
  excusedAt    DateTime? @map("excused_at") @db.Timestamptz(6)

  @@index([tenantId, breachedAt(sort: Desc)])
  @@map("breach_record")
}

// ===========================================================================
// modules/tenancy/prisma/schema.prisma
// ===========================================================================

/// MOD-21 Tenancy, licensing and billing.
/// Tenant, TenantDomain, ChannelDirectory, ConsumerRegistry and Plan are
/// PLATFORM tables: they carry no tenant_id because they are what resolves a
/// tenant in the first place. See docs/architecture/05 §2 and 06 §3.

model Tenant {
  id              String    @id @db.Uuid
  name            String
  slug            String    @unique
  status          String    @default("provisioning")
  parentTenantId  String?   @map("parent_tenant_id") @db.Uuid
  region          String    @default("eu-west")
  planKey         String?   @map("plan_key")
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  domains         TenantDomain[]
  provisioning    TenantProvisioningJob[]

  @@index([status])
  @@map("tenant")
}

model TenantDomain {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  host      String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domain")
}

/// Maps an external channel account (mailbox, workspace, number) to a tenant so
/// an inbound provider webhook can be routed before any tenant context exists.
model ChannelDirectory {
  id         String   @id @db.Uuid
  channel    String
  externalId String   @map("external_id")
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([channel, externalId])
  @@map("channel_directory")
}

model TenantGrant {
  id               String    @id @db.Uuid
  granteeTenantId  String    @map("grantee_tenant_id") @db.Uuid
  targetTenantId   String    @map("target_tenant_id") @db.Uuid
  scope            Json      @default("{}")
  grantedBy        String    @map("granted_by") @db.Uuid
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo          DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([granteeTenantId, targetTenantId])
  @@index([targetTenantId])
  @@map("tenant_grant")
}

model TenantProvisioningJob {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  steps      Json      @default("[]")
  status     String    @default("pending")
  error      String?
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_provisioning_job")
}

/// Organisations are a soft boundary INSIDE a tenant: nested, with a
/// materialised path for subtree queries used by scoped permissions.
model Organisation {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String
  code      String
  type      String    @default("business_unit")
  path      String
  settings  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  @@unique([tenantId, code])
  @@index([tenantId, path])
  @@index([tenantId, parentId])
  @@map("organisation")
}

// ===========================================================================
// modules/ticket/prisma/schema.prisma
// ===========================================================================

/// MOD-04 Ticket and interaction core — the system of record.

model Ticket {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  orgId          String?   @map("org_id") @db.Uuid
  number         String
  type           String
  title          String
  description    String?
  descriptionFormat String @default("text") @map("description_format")
  status         String
  statusCategory String    @map("status_category")
  priority       String    @default("P3")
  impact         String?
  urgency        String?
  requesterId    String?   @map("requester_id") @db.Uuid
  affectedUserId String?   @map("affected_user_id") @db.Uuid
  assigneeId     String?   @map("assignee_id") @db.Uuid
  groupId        String?   @map("group_id") @db.Uuid
  serviceId      String?   @map("service_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  sourceChannel  String    @default("api") @map("source_channel")
  channelRef     String?   @map("channel_ref")
  parentId       String?   @map("parent_id") @db.Uuid
  slaPolicyId    String?   @map("sla_policy_id") @db.Uuid
  dueAt          DateTime? @map("due_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  reopenCount    Int       @default(0) @map("reopen_count")
  mergedIntoId   String?   @map("merged_into_id") @db.Uuid
  externalRef    String?   @map("external_ref")
  custom         Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdByType  String    @default("user") @map("created_by_type")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  comments    TicketComment[]
  events      TicketEvent[]
  tasks       TicketTask[]
  attachments Attachment[]
  watchers    TicketWatcher[]
  tags        TicketTag[]

  @@unique([tenantId, number])
  @@index([tenantId, statusCategory, priority, dueAt])
  @@index([tenantId, assigneeId, statusCategory])
  @@index([tenantId, groupId, statusCategory, createdAt(sort: Desc)])
  @@index([tenantId, requesterId, createdAt(sort: Desc)])
  @@index([tenantId, serviceId, createdAt(sort: Desc)])
  @@index([tenantId, type, statusCategory])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("ticket")
}

model TicketComment {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  authorId   String?   @map("author_id") @db.Uuid
  authorType String    @default("user") @map("author_type")
  visibility String    @default("public")
  body       String
  bodyFormat String    @default("text") @map("body_format")
  channel    String    @default("api")
  externalRef String?  @map("external_ref")
  quotedBody String?   @map("quoted_body")
  editedAt   DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  version    Int       @default(1)

  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, visibility])
  @@map("ticket_comment")
}

/// Structured timeline entries: status changes, assignments, SLA events,
/// automation. Distinct from comments, which are conversation.
model TicketEvent {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  type       String
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  payload    Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, occurredAt])
  @@map("ticket_event")
}

model Attachment {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  ticketId     String    @map("ticket_id") @db.Uuid
  commentId    String?   @map("comment_id") @db.Uuid
  objectKey    String    @map("object_key")
  filename     String
  mime         String
  size         Int
  scanStatus   String    @default("pending") @map("scan_status")
  scanVerdict  String?   @map("scan_verdict")
  scannedAt    DateTime? @map("scanned_at") @db.Timestamptz(6)
  classification String  @default("internal")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId])
  @@index([tenantId, scanStatus])
  @@map("attachment")
}

model TicketTask {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  ticketId    String    @map("ticket_id") @db.Uuid
  key         String?
  title       String
  description String?
  status      String    @default("open")
  assigneeId  String?   @map("assignee_id") @db.Uuid
  groupId     String?   @map("group_id") @db.Uuid
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  order       Int       @default(0)
  blockedBy   String[]  @default([]) @map("blocked_by")
  visibility  String    @default("internal")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int       @default(1)

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, order])
  @@index([tenantId, assigneeId, status])
  @@map("ticket_task")
}

model TicketLink {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  linkType  String   @map("link_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([sourceId, targetId, linkType])
  @@index([tenantId, targetId])
  @@map("ticket_link")
}

/// Free-form labels. A table rather than an array column so that a tag can be
/// renamed, counted and indexed, and so the rules engine adding one is an
/// ordinary insert rather than a read-modify-write race on a JSON column.
model TicketTag {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  tag       String
  addedBy   String?  @map("added_by") @db.Uuid
  addedByType String @default("user") @map("added_by_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, tag])
  @@index([tenantId, tag])
  @@map("ticket_tag")
}

model TicketWatcher {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reason    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([tenantId, userId])
  @@map("ticket_watcher")
}

model SavedView {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  query     Json     @default("{}")
  isShared  Boolean  @default(false) @map("is_shared")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  @@index([tenantId, ownerId])
  @@map("saved_view")
}

model Category {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  orgId          String?   @map("org_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  key            String
  path           String
  defaultGroupId String?   @map("default_group_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  version        Int       @default(1)

  @@unique([tenantId, key])
  @@index([tenantId, path])
  @@map("category")
}

/// Custom fields (PH-2 feature flag `ticket.customFields`), defined in PH-1 so
/// the ticket API validates `custom` against them from the start.
model FieldDefinition {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  orgId        String?   @map("org_id") @db.Uuid
  key          String
  label        String
  type         String
  options      Json      @default("[]")
  appliesTo    Json      @default("{}") @map("applies_to")
  requiredWhen Json?     @map("required_when")
  visibleTo    String[]  @default([]) @map("visible_to")
  classification String  @default("internal")
  order        Int       @default(0)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int       @default(1)

  @@unique([tenantId, key])
  @@map("field_definition")
}

/// Per-tenant, per-type sequence for human-readable numbers. Incremented inside
/// the creating transaction so a rollback leaves no gap (ADR-0020).
model TicketCounter {
  tenantId String @map("tenant_id") @db.Uuid
  type     String
  next     Int    @default(1)

  @@id([tenantId, type])
  @@map("ticket_counter")
}

