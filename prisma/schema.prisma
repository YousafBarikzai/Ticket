/// MOD-11 Notifications, collaboration and communications.

model NotificationTemplate {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  key       String
  channel   String
  locale    String   @default("en-GB")
  subject   String?
  body      String
  bodyFormat String  @default("text") @map("body_format")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, key, channel, locale])
  @@map("notification_template")
}

model NotificationRule {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  key         String
  eventType   String   @map("event_type")
  conditions  Json?
  /// Audience descriptors: requester, assignee, group, watchers, role:<key>.
  audience    Json     @default("[]")
  templateKey String   @map("template_key")
  channels    String[] @default(["inapp"])
  isEmergency Boolean  @default(false) @map("is_emergency")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(1)

  @@unique([tenantId, key])
  @@index([tenantId, eventType, isActive])
  @@map("notification_rule")
}

model Notification {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  eventType   String    @map("event_type")
  recipientId String    @map("recipient_id") @db.Uuid
  ruleKey     String    @map("rule_key")
  templateKey String    @map("template_key")
  ticketId    String?   @map("ticket_id") @db.Uuid
  subject     String?
  body        String
  status      String    @default("queued")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  attempts    DeliveryAttempt[]

  /// One notification per recipient per event per rule: the uniqueness that
  /// makes dispatch idempotent under retries.
  @@unique([eventId, recipientId, ruleKey])
  @@index([tenantId, recipientId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("notification")
}

model DeliveryAttempt {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  channel        String
  attempt        Int       @default(1)
  status         String    @default("pending")
  providerRef    String?   @map("provider_ref")
  error          String?
  attemptedAt    DateTime  @default(now()) @map("attempted_at") @db.Timestamptz(6)

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([tenantId, notificationId])
  @@index([tenantId, status, attemptedAt(sort: Desc)])
  @@map("delivery_attempt")
}

model NotificationPreference {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  channel    String
  enabled    Boolean  @default(true)
  quietHours Json?    @map("quiet_hours")
  digestMode String   @default("immediate") @map("digest_mode")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, channel])
  @@index([tenantId, userId])
  @@map("notification_preference")
}

model DeviceRegistration {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  platform   String
  pushToken  String   @map("push_token")
  appVersion String?  @map("app_version")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, pushToken])
  @@index([tenantId, userId])
  @@map("device_registration")
}

// ===========================================================================
// modules/problem/prisma/schema.prisma
// ===========================================================================

/// MOD-08-E2 Problem management (PH-4).
///
/// A problem is the cause behind incidents. The practice has a reputation for
/// being the one nobody does, and the reason is that it is usually built around
/// its least useful moment: finding the root cause, weeks later, when everybody
/// has moved on.
///
/// This module is built around a different moment. The most valuable thing
/// problem management produces is the **workaround** — the thing that stops the
/// next person losing an hour — and it is available long before anybody knows
/// why. So a problem may become a known error without a root cause, and the
/// root cause is something it acquires later, if at all.

/// The cause behind one or more incidents.
model Problem {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  number        String
  title         String
  description   String?
  /// investigating | known_error | resolved | closed
  status        String    @default("investigating")
  priority      String    @default("P3")
  categoryId    String?   @map("category_id") @db.Uuid
  serviceId     String?   @map("service_id") @db.Uuid
  /// Who is accountable for getting to the bottom of it. A problem with no
  /// owner is a list entry, and problem backlogs are mostly list entries.
  ownerId       String?   @map("owner_id") @db.Uuid

  /// major_incident | ticket_trend | manual — where it came from, which is the
  /// only honest way to answer "is our problem management working?".
  raisedFrom    String    @default("manual") @map("raised_from")
  /// The major incident whose review raised it, when that is where it came from.
  majorIncidentId String? @map("major_incident_id") @db.Uuid

  /// Filled in if and when it is understood. Deliberately not required to
  /// publish a workaround, and deliberately not required to close: a problem
  /// closed as "not reproducible after six months" is an honest outcome, and a
  /// forced field would turn it into a fictional one.
  rootCause     String?   @map("root_cause")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int       @default(1)

  knownError    KnownError?
  tickets       ProblemTicket[]

  @@unique([tenantId, number])
  @@index([tenantId, status, priority])
  @@index([tenantId, serviceId, status])
  @@index([tenantId, majorIncidentId])
  @@map("problem")
}

/// A published workaround.
///
/// Separate from the problem because it has its own life: it is published at one
/// moment, read by people for weeks, and **retired** at another. A workaround
/// that outlives its problem is worse than none — an agent follows it, it does
/// not work because the bug is fixed, and they lose the time twice.
model KnownError {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  problemId   String    @unique @map("problem_id") @db.Uuid
  /// What somebody sees when they hit it. Written from the reporter's side, not
  /// the engineer's, because it is matched against what a person describes.
  symptom     String
  workaround  String
  /// The knowledge article carrying the same words (MOD-09). A link rather than
  /// a copy: a workaround written in two places diverges, and the one that is
  /// wrong is the one somebody reads.
  articleKey  String?   @map("article_key")
  /// published | retired
  status      String    @default("published")
  publishedAt DateTime  @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy String?   @map("published_by") @db.Uuid
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)
  retiredReason String? @map("retired_reason")

  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("known_error")
}

/// A ticket this problem caused.
///
/// The link is what makes a problem arguable. "This should be fixed" is an
/// opinion; "this has hit forty-one people since March, eleven of them twice"
/// is a case, and it is the only thing that gets a problem prioritised against
/// feature work.
model ProblemTicket {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  problemId String   @map("problem_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  /// Whether the workaround was applied to this one, so its value is countable
  /// rather than assumed.
  workaroundApplied Boolean @default(false) @map("workaround_applied")
  linkedAt  DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  linkedBy  String?  @map("linked_by") @db.Uuid

  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, problemId, ticketId])
  @@index([tenantId, ticketId])
  @@map("problem_ticket")
}

// ===========================================================================
// modules/rules/prisma/schema.prisma
// ===========================================================================

/// MOD-06 Workflow and rules (PH-2 slice: the business rules engine).
///
/// Rules are data, not code (ADR-0009): a row here is interpreted, never
/// generated or evaluated as a script. The workflow engine of PH-3 is a
/// sibling model in this module and shares the same versioned-definition
/// lifecycle.

model BusinessRule {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  key         String
  name        String
  description String?
  /// The event this rule reacts to; one of RULE_EVENTS.
  event       String
  /// An expression from @itsm/expr, evaluated against the rule facts.
  conditions  Json     @default("{\"always\":true}")
  /// An ordered list of actions from the closed set in domain/actions.ts.
  actions     Json     @default("[]")
  /// Rules for one event run in ascending order.
  order       Int      @default(100)
  /// stop: no further rule runs for this event once this one matches.
  mode        String   @default("continue")
  status      String   @default("draft")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy String?  @map("published_by") @db.Uuid

  versions    BusinessRuleVersion[]
  applications RuleApplication[]

  @@unique([tenantId, key])
  @@index([tenantId, event, status, order])
  @@map("business_rule")
}

/// One immutable snapshot per publish, so a rule can be rolled back and so an
/// application can name exactly which text of the rule ran.
model BusinessRuleVersion {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ruleId      String   @map("rule_id") @db.Uuid
  version     Int
  snapshot    Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy String?  @map("published_by") @db.Uuid

  rule        BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([tenantId])
  @@map("business_rule_version")
}

/// What a rule actually did. The audit trail records it too, but this is the
/// shape the rule author needs: one row per rule per event, with the actions
/// that were applied and the ones that were skipped because an earlier rule had
/// already set that field.
model RuleApplication {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ruleId      String   @map("rule_id") @db.Uuid
  ruleVersion Int      @map("rule_version")
  ticketId    String?  @map("ticket_id") @db.Uuid
  event       String
  applied     Json     @default("[]")
  skipped     Json     @default("[]")
  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  rule        BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId])
  @@index([tenantId, ruleId, appliedAt(sort: Desc)])
  @@map("rule_application")
}

