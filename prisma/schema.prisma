  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(1)

  schedules   ReportSchedule[]
  runs        ReportRun[]

  @@unique([tenantId, key])
  @@map("report_definition")
}

/// When a report runs and who gets it.
///
/// A structured schedule rather than a cron string: "every Monday at 08:00 in
/// Europe/London" is what a person means, it survives daylight saving without
/// an argument about which 08:00, and there is nothing to mis-parse.
model ReportSchedule {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  reportId    String   @map("report_id") @db.Uuid
  /// daily | weekly | monthly
  frequency   String
  hour        Int
  minute      Int      @default(0)
  /// 0 = Sunday … 6 = Saturday, for weekly.
  dayOfWeek   Int?     @map("day_of_week")
  /// 1–28, for monthly: a day every month has, so nothing is silently skipped
  /// in February.
  dayOfMonth  Int?     @map("day_of_month")
  timeZone    String   @map("time_zone")
  /// Audience descriptors (user, role), resolved by MOD-11 at delivery.
  recipients  Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt   DateTime @map("next_run_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  report      ReportDefinition @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, nextRunAt])
  @@index([tenantId, reportId])
  @@map("report_schedule")
}

/// One execution of a report, with its result kept.
///
/// The result lives here as JSON and the CSV is rendered from it on request.
/// Nothing is written to object storage, because the platform has no
/// server-side upload path and a report is small: a row limit keeps it so.
model ReportRun {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  reportId    String   @map("report_id") @db.Uuid
  scheduleId  String?  @map("schedule_id") @db.Uuid
  /// running | done | failed
  status      String   @default("running")
  requestedBy String?  @map("requested_by") @db.Uuid
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  periodFrom  DateTime @map("period_from") @db.Timestamptz(6)
  periodTo    DateTime @map("period_to") @db.Timestamptz(6)
  result      Json     @default("[]")
  rowCount    Int      @default(0) @map("row_count")
  summary     String?
  error       String?

  report      ReportDefinition @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([tenantId, reportId, startedAt(sort: Desc)])
  @@map("report_run")
}

/// One row per time entry, kept apart by kind: logged effort and elapsed
/// time are different questions and this table lets a metric ask either.
model FactTimeEntry {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entryId     String   @map("entry_id") @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  teamId      String?  @map("team_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  activityKey String   @map("activity_key")
  /// manual | timer | automatic
  kind        String
  minutes     Int
  cost        Decimal  @default(0) @db.Decimal(14, 2)
  currency    String   @db.Char(3)
  billable    Boolean  @default(true)
  loggedDate  DateTime @map("logged_date") @db.Date
  loggedAt    DateTime @map("logged_at") @db.Timestamptz(6)

  lastEventId String   @map("last_event_id") @db.Uuid
  lastEventAt DateTime @map("last_event_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, entryId])
  @@index([tenantId, loggedDate])
  @@index([tenantId, teamId, loggedDate])
  @@index([tenantId, kind, loggedDate])
  @@map("fact_time_entry")
}

// ===========================================================================
// modules/approvals/prisma/schema.prisma
// ===========================================================================

/// MOD-17 Approvals (PH-2).
///
/// An approval policy is a versioned definition like every other builder object
/// (docs/architecture/05 §8): steps are JSON, interpreted at run time, and a
/// request pins the version it started on so a policy edited mid-flight cannot
/// change the rules under a decision already in progress.

model ApprovalPolicy {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  key         String
  name        String
  description String?
  /// What this policy applies to: request, change, knowledge, config, ticket.
  subjectType String   @map("subject_type")
  /// Expression matched against the subject; the most specific match wins.
  match       Json     @default("{\"always\":true}")
  specificity Int      @default(0)
  /// An ordered list of steps; see domain/policy.ts for the shape.
  steps       Json     @default("[]")
  status      String   @default("draft")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy String?  @map("published_by") @db.Uuid

  versions    ApprovalPolicyVersion[]
  requests    ApprovalRequest[]

  @@unique([tenantId, key])
  @@index([tenantId, subjectType, status, specificity(sort: Desc)])
  @@map("approval_policy")
}

model ApprovalPolicyVersion {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  policyId    String   @map("policy_id") @db.Uuid
  version     Int
  snapshot    Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy String?  @map("published_by") @db.Uuid

  policy      ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([tenantId])
  @@map("approval_policy_version")
}

model ApprovalRequest {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  policyId      String    @map("policy_id") @db.Uuid
  policyVersion Int       @map("policy_version")
  subjectType   String    @map("subject_type")
  subjectId     String    @map("subject_id") @db.Uuid
  ticketId      String?   @map("ticket_id") @db.Uuid
  status        String    @default("pending")
  outcome       String?
  requestedBy   String?   @map("requested_by") @db.Uuid
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  dueAt         DateTime? @map("due_at") @db.Timestamptz(6)
  version       Int       @default(1)

  policy        ApprovalPolicy @relation(fields: [policyId], references: [id])
  steps         ApprovalStep[]

  /// One live approval per subject: a second request for the same change is a
  /// bug, not a second opinion.
  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, ticketId])
  @@map("approval_request")
}

model ApprovalStep {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  requestId   String    @map("request_id") @db.Uuid
  sequence    Int
  name        String
  /// How many of the resolved approvers must approve for the step to pass.
  quorum      Int       @default(1)
  /// Resolved when the step opens, not when the policy was written: who someone
  /// reports to changes, and the decision must reflect the org chart as it is.
  approverIds String[]  @map("approver_ids")
  status      String    @default("waiting")
  openedAt    DateTime? @map("opened_at") @db.Timestamptz(6)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  onTimeout   String    @default("escalate") @map("on_timeout")

  request     ApprovalRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decisions   ApprovalDecision[]

  @@unique([requestId, sequence])
  @@index([tenantId, status, dueAt])
  @@map("approval_step")
}

model ApprovalDecision {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  stepId     String   @map("step_id") @db.Uuid
  approverId String   @map("approver_id") @db.Uuid
  /// Who actually decided, when a delegate acted for the named approver.
  actedById  String?  @map("acted_by_id") @db.Uuid
  decision   String
  comment    String?
  via        String   @default("api")
  decidedAt  DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  step       ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  /// One decision per approver per step; changing your mind is a new step, not
  /// an edit, so the trail stays honest.
  @@unique([stepId, approverId])
  @@index([tenantId, approverId])
  @@map("approval_decision")
}

model ApprovalDelegation {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fromUserId   String   @map("from_user_id") @db.Uuid
  toUserId     String   @map("to_user_id") @db.Uuid
  reason       String?
  startsAt     DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  @@index([tenantId, fromUserId, startsAt, endsAt])
  @@map("approval_delegation")
}

// ===========================================================================
// modules/assets/prisma/schema.prisma
// ===========================================================================

/// MOD-10-E1 Assets and the CMDB (PH-4).
///
/// Two registers, deliberately, and the distinction is the one most CMDBs get
/// wrong by collapsing:
///
///   - An **asset** is a thing you own. Finance's question: what did it cost,
///     who has it, when does the warranty run out?
///   - A **configuration item** is a thing that can break. Operations'
///     question: what depends on it, and what falls over if it does?
///
/// The same laptop is both. A spare monitor in a cupboard is an asset and not a
/// CI — nothing depends on it. A SaaS platform you consume is a CI and not an
/// asset — you own nothing. Conflating them produces a register that answers
/// neither question well, because every field is optional for half the rows.

/// What kind of thing a CI is, and what attributes that kind carries.
///
/// A class rather than a column per kind: a server has a CPU count and a
/// database has an engine, and a schema that tried to hold both would be a
/// hundred nullable columns nobody could query.
model CiClass {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  /// Declared attributes: `[{ "key": "cpuCount", "type": "number", "required": true }]`.
  /// Validated on write, so a typo becomes an error at the moment somebody can
  /// still remember what they meant.
  attributes  Json     @default("[]")
  /// The class this one specialises, so "Database Server" inherits "Server".
  parentId    String?  @map("parent_id") @db.Uuid
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items       ConfigurationItem[]
  parent      CiClass?  @relation("subclass", fields: [parentId], references: [id], onDelete: SetNull)
  children    CiClass[] @relation("subclass")

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("ci_class")
}

/// A thing that can break.
model ConfigurationItem {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  name        String
  /// Stable across renames and rediscovery — a serial, a FQDN, a cloud
  /// resource id. What reconciliation matches on, so it is unique per tenant.
  externalKey String?   @map("external_key")
  description String?
  /// operational | degraded | down | retired. A CI is retired, never deleted:
  /// deleting it breaks every incident and change that named it, and the
  /// history is the reason to have a CMDB at all.
  status      String    @default("operational")
  /// How important it is, which is what turns a traversal result into a
  /// priority. low | medium | high | critical.
  criticality String    @default("medium")
  /// The service this CI serves (MOD-05), so impact reaches a name a person
  /// recognises rather than stopping at a hostname.
  serviceId   String?   @map("service_id") @db.Uuid
  ownerId     String?   @map("owner_id") @db.Uuid
  environment String?
  /// Attributes declared by the class.
  attributes  Json      @default("{}")
  /// manual | import | discovery — where this record came from. Discovery
  /// (E2) reads it before it overwrites anything.
  source      String    @default("manual")
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)
  version     Int       @default(1)

  ciClass     CiClass   @relation(fields: [classId], references: [id], onDelete: Restrict)
  asset       Asset?
  outgoing    CiRelationship[] @relation("from")
  incoming    CiRelationship[] @relation("to")
  affected    AffectedCi[]

  @@unique([tenantId, externalKey])
  @@index([tenantId, status, criticality])
  @@index([tenantId, classId, status])
  @@index([tenantId, serviceId])
  @@map("configuration_item")
}

/// What depends on what.
///
/// Typed and directed. `from depends_on to` means: if `to` falls over, `from`
/// is in trouble. Getting that direction consistently right is most of what
/// makes an impact answer trustworthy, so it is stated once here and every
/// traversal reads it the same way.
model CiRelationship {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  fromCi    String   @map("from_ci") @db.Uuid
  toCi      String   @map("to_ci") @db.Uuid
  /// depends_on | runs_on | connected_to | member_of | installed_on
  type      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  from      ConfigurationItem @relation("from", fields: [fromCi], references: [id], onDelete: Cascade)
  to        ConfigurationItem @relation("to", fields: [toCi], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromCi, toCi, type])
  @@index([tenantId, fromCi, type])
  @@index([tenantId, toCi, type])
  @@map("ci_relationship")
}

/// A make and model, so a hundred identical laptops carry the specification
/// once rather than a hundred times with three spellings.
model AssetModel {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  manufacturer String
  model        String
  category     String   @default("hardware")
  /// Months of expected life, for the replacement forecast that is the main
  /// reason finance asks for an asset register.
  lifespanMonths Int?   @map("lifespan_months")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  assets       Asset[]

  @@unique([tenantId, manufacturer, model])
  @@map("asset_model")
}

/// A thing you own.
model Asset {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// The tag on the sticker. What somebody reads out over the phone.
  tag         String
  serial      String?
  modelId     String?   @map("model_id") @db.Uuid
  /// in_stock | assigned | in_repair | retired | disposed
  status      String    @default("in_stock")
  /// The CI this asset is, when it is one. Optional in both directions: a
  /// spare monitor is an asset and no CI; a SaaS platform is a CI and no asset.
  ciId        String?   @unique @map("ci_id") @db.Uuid

  purchasedOn DateTime? @map("purchased_on") @db.Date
  purchaseCost Decimal? @map("purchase_cost") @db.Decimal(12, 2)
  currency    String?   @db.Char(3)
  warrantyEndsOn DateTime? @map("warranty_ends_on") @db.Date
  supplier    String?
  costCentre  String?   @map("cost_centre")
  location    String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)
  version     Int       @default(1)

  model       AssetModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  ci          ConfigurationItem? @relation(fields: [ciId], references: [id], onDelete: SetNull)
  assignments AssetAssignment[]

  @@unique([tenantId, tag])
  @@index([tenantId, status])
  @@index([tenantId, serial])
  @@index([tenantId, warrantyEndsOn])
  @@map("asset")
}

/// Who has it, and when they had it.
///
/// A history rather than a column, because "who had this laptop in March?" is
/// the question asked after something is found on it, and a current-holder
/// column cannot answer it.
model AssetAssignment {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  assetId    String    @map("asset_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  /// Where it is when nobody has it: a room, a rack, a drawer.
  location   String?
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  returnedAt DateTime? @map("returned_at") @db.Timestamptz(6)
  note       String?
  createdBy  String?   @map("created_by") @db.Uuid

  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, assetId, assignedAt])
  @@index([tenantId, userId, returnedAt])
  @@map("asset_assignment")
}

/// What a ticket, incident or change touched.
///
/// One table for every kind of record rather than a link table per module: the
/// question "what did we change on this CI?" has to reach across all of them,
/// and three tables would mean three queries and one of them forgotten.
///
/// This is the gap MOD-08 left. A change record that cannot name what it
/// changed is a change record you cannot correlate with the outage that
/// followed it.
model AffectedCi {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// ticket | major_incident | problem | change
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  ciId       String   @map("ci_id") @db.Uuid
  /// affected | caused_by | changed — what the record did to the CI, or the CI
  /// to the record.
  role       String   @default("affected")
  linkedAt   DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  linkedBy   String?  @map("linked_by") @db.Uuid

  /// Cascading, which only ever fires on a tenant purge: configuration items
  /// are retired, never deleted, precisely so this history survives.
  ci         ConfigurationItem @relation(fields: [ciId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId, ciId, role])
  @@index([tenantId, ciId, linkedAt])
  @@index([tenantId, entityType, entityId])
  @@map("affected_ci")
}

// ---- MOD-10-E2 Discovery, reconciliation and the money -----------------------

/// Somewhere configuration items come from other than a person typing.
///
/// A source is a *credentialed pull*, not a push endpoint: the platform decides
/// when to ask and what to do with the answer. A push endpoint would mean any
/// system that ever held a token could rewrite the register, and the register's
/// worth is that its contents were decided.
model DiscoverySource {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  key          String
  name         String
  /// http_json | csv | intune | aws | azure. The last three are the first two
  /// with a mapping already filled in — see `src/sources/`.
  kind         String
  /// The MOD-14 connector credential to attach, by name. Never the credential.
  credentialRef String?  @map("credential_ref")
  /// Where to ask, how to read the answer, and which fields map to what.
  config       Json      @default("{}")
  /// Minutes between runs. Null means it runs only when somebody asks.
  intervalMinutes Int?   @map("interval_minutes")
  status       String    @default("active")
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastRunStatus String?  @map("last_run_status")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  runs         DiscoveryRun[]
  rules        ReconciliationRule[]

  @@unique([tenantId, key])
  @@index([tenantId, status, lastRunAt])
  @@map("discovery_source")
}

/// One pull, and what it found.
///
/// Kept even when nothing changed, because "the source has been returning zero
/// devices for a fortnight" is a fact nobody notices without a run history —
/// and a source that quietly stops is indistinguishable from an estate that
/// quietly stopped changing.
model DiscoveryRun {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  sourceId    String    @map("source_id") @db.Uuid
  /// running | completed | failed
  status      String    @default("running")
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Records read from the source.
  seen        Int       @default(0)
  /// Records that matched an item and agreed with it.
  unchanged   Int       @default(0)
  /// Proposals raised: new items, changed fields, suggested relationships.
  proposed    Int       @default(0)
  /// Fields written without asking, because a reconciliation rule says the
  /// source owns them. The audit question this table exists to answer: what did
  /// discovery change on its own authority?
  applied     Int       @default(0)
  /// Records the mapping refused, with the reason. Refusing one row must not
  /// lose the other three hundred.
  rejected    Int       @default(0)
  problems    Json      @default("[]")
  error       String?
  triggeredBy String?   @map("triggered_by") @db.Uuid

  source      DiscoverySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  proposals   DiscoveryProposal[]

  @@index([tenantId, sourceId, startedAt])
  @@index([tenantId, status])
  @@map("discovery_run")
}

/// What discovery would like to do, waiting for somebody to say yes.
///
/// The whole design of E2 in one table. Discovery proposes; a person confirms.
/// A feed that could write straight through is a feed that can rewrite four
/// hundred rows at three in the morning because somebody changed a column name
/// upstream, and the first anybody knows of it is an impact answer that is
/// quietly wrong.
model DiscoveryProposal {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  sourceId    String    @map("source_id") @db.Uuid
  /// create_ci | update_ci | create_relationship
  kind        String
  /// What the source calls it, so a superseded proposal can be found again.
  externalKey String    @map("external_key")
  /// The item this is about, once matched. Null for a creation.
  ciId        String?   @map("ci_id") @db.Uuid
  /// The fields discovery would set, and what they are now. Both, because a
  /// proposal a person cannot see the *current* value of is one they cannot
  /// judge.
  proposed    Json      @default("{}")
  current     Json      @default("{}")
  /// pending | accepted | rejected | superseded
  status      String    @default("pending")
  /// Why a person said no, so the same proposal arriving next week is
  /// recognisable rather than re-litigated.
  reason      String?
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy   String?   @map("decided_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  run         DiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, sourceId, externalKey, status])
  @@index([tenantId, ciId])
  @@map("discovery_proposal")
}

/// Which fields a source may set without asking.
///
/// The default is `propose` for everything, and a tenant loosens it field by
/// field once it trusts a source. Loosening is the interesting direction: a
/// serial number from Intune is more reliable than a serial number typed by a
/// person, and criticality is the exact opposite.
model ReconciliationRule {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Null applies the rule to every source.
  sourceId  String?  @map("source_id") @db.Uuid
  /// A configuration item field, or `attributes.<key>`.
  field     String
  /// propose | source_wins | ignore
  policy    String   @default("propose")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  source    DiscoverySource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceId, field])
  @@index([tenantId, field])
  @@map("reconciliation_rule")
}

/// Who you buy from.
model Supplier {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  accountRef   String?  @map("account_ref")
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  /// Who to call when the thing you bought stops working, which is the only
  /// reason anybody opens this record.
  supportUrl   String?  @map("support_url")
  supportPhone String?  @map("support_phone")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contracts    Contract[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("supplier")
}

/// What you agreed to pay, until when, and by when you must say otherwise.
model Contract {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  supplierId  String    @map("supplier_id") @db.Uuid
  reference   String
  name        String
  /// support | maintenance | lease | licence | subscription
  kind        String    @default("support")
  startsOn    DateTime  @map("starts_on") @db.Date
  endsOn      DateTime  @map("ends_on") @db.Date
  /// Days before `ends_on` by which notice must be given to stop it renewing.
  /// The date that actually matters: after it, renewal is no longer a choice.
  noticeDays  Int?      @map("notice_days")
  autoRenews  Boolean   @default(false) @map("auto_renews")
  cost        Decimal?  @db.Decimal(14, 2)
  currency    String?   @db.Char(3)
  /// annual | monthly | one_off — a cost without a period is not comparable.
  costPeriod  String?   @map("cost_period")
  costCentre  String?   @map("cost_centre")
  ownerId     String?   @map("owner_id") @db.Uuid
  documentUrl String?   @map("document_url")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  coverage    ContractCoverage[]

  @@unique([tenantId, supplierId, reference])
  @@index([tenantId, status, endsOn])
  @@index([tenantId, supplierId])
  @@map("contract")
}

/// What a contract covers.
///
/// A join rather than a column on the asset, because one laptop can be under a
/// lease and a support contract at once, and a column would make somebody
/// choose which of the two to record.
model ContractCoverage {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  assetId    String?  @map("asset_id") @db.Uuid
  ciId       String?  @map("ci_id") @db.Uuid
  note       String?
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contractId, assetId, ciId])
  @@index([tenantId, assetId])
  @@index([tenantId, ciId])
  @@map("contract_coverage")
}

// ===========================================================================
// modules/catalogue/prisma/schema.prisma
// ===========================================================================

/// MOD-05 Service catalogue and request fulfilment, with MOD-02's forms (PH-2).
///
/// A catalogue item is what a requester actually asks for. It joins three
/// versioned things: the service it belongs to, the form that collects the
/// request, and the entitlement that decides who may see it at all.

model Service {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  key         String
  name        String
  description String?
  /// The person accountable for this service. Resolves `serviceOwner`
  /// approvers (MOD-17) and owns the service's SLA reporting.
  ownerId     String?  @map("owner_id") @db.Uuid
  /// The team that fulfils requests for it, unless an offering overrides.
  groupId     String?  @map("group_id") @db.Uuid
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestTypes RequestType[]

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("service")
}

/// One thing a requester can ask for.
model RequestType {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  key           String
  name          String
  description   String?
  /// Shown in the portal tile, before the form is opened.
  shortSummary  String?  @map("short_summary")
  formKey       String?  @map("form_key")
  /// Who may see and raise this. An expression over the requester's facts;
  /// absent means everyone in the tenant.
  entitlement   Json?
  /// The team that fulfils it, overriding the service's.
  groupId       String?  @map("group_id") @db.Uuid
  priority      String   @default("P3")
  status        String   @default("draft")
  sortOrder     Int      @default(100) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  submissions   FormSubmission[]

  @@unique([tenantId, key])
  @@index([tenantId, status, sortOrder])
  @@index([tenantId, serviceId])
  @@map("request_type")
}

/// MOD-02's form, as a versioned definition.
model FormDefinitionRecord {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  /// The document in packages/contracts' FormDefinition shape: a JSON Schema
  /// for the data and a UI schema for how it is presented.
  document    Json     @default("{}")
  status      String   @default("draft")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy String?  @map("published_by") @db.Uuid

  versions    FormVersionRecord[]

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("form_definition")
}

model FormVersionRecord {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  version      Int
  document     Json
  publishedAt  DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy  String?  @map("published_by") @db.Uuid

  definition   FormDefinitionRecord @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  submissions  FormSubmission[]

  @@unique([definitionId, version])
  @@index([tenantId])
  @@map("form_version")
}

/// What somebody actually answered.
///
/// Pinned to the form version they were shown, so a form edited afterwards
/// cannot make an old submission look invalid — or, worse, make it look as
/// though they were asked a question they never saw.
model FormSubmission {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  requestTypeId String?  @map("request_type_id") @db.Uuid
  formVersionId String   @map("form_version_id") @db.Uuid
  ticketId      String?  @map("ticket_id") @db.Uuid
  submittedBy   String?  @map("submitted_by") @db.Uuid
  answers       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  requestType   RequestType?      @relation(fields: [requestTypeId], references: [id])
  formVersion   FormVersionRecord @relation(fields: [formVersionId], references: [id])

  @@index([tenantId, ticketId])
  @@index([tenantId, requestTypeId, createdAt(sort: Desc)])
  @@map("form_submission")
}

// ===========================================================================
// modules/change/prisma/schema.prisma
// ===========================================================================

/// MOD-08-E3 Change management (PH-4).
///
/// Change control has one characteristic failure, and it is not changes going
/// wrong — it is changes going *unrecorded*. Every control that makes recording
/// a change more expensive than not recording one buys a little safety and
/// spends a lot of coverage, and a change record with holes in it is worse than
/// none, because it is trusted.
///
/// So the controls here are arranged to be cheap where they can be refused
/// (a blackout window is enforced, not warned about) and honest where they
/// cannot (an emergency change is recorded first and approved afterwards).

model Change {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  number        String
  title         String
  description   String?
  /// standard | normal | emergency — the three ITIL kinds, and the only thing
  /// that decides how a change is approved.
  kind          String    @default("normal")
  /// draft | submitted | approved | rejected | scheduled | implementing | review | closed | cancelled
  status        String    @default("draft")
  risk          String    @default("medium")
  impact        String    @default("medium")

  serviceId     String?   @map("service_id") @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  /// The problem this change is the permanent fix for, when it is one.
  problemId     String?   @map("problem_id") @db.Uuid
  /// The major incident that forced it, for an emergency change.
  majorIncidentId String? @map("major_incident_id") @db.Uuid

  requestedBy   String?   @map("requested_by") @db.Uuid
  /// Who is accountable for it going in and coming out again.
  ownerId       String?   @map("owner_id") @db.Uuid

  /// The pre-approved template this came from, for a standard change. Pinned
  /// to the version that was approved, so editing the template later cannot
  /// retroactively change what somebody signed off.
  templateId      String? @map("template_id") @db.Uuid
  templateVersion Int?    @map("template_version")

  /// What the plan is, and what happens when it does not work. A change with
  /// no back-out plan is a change nobody can undo at 2am.
  implementationPlan String? @map("implementation_plan")
  backoutPlan        String? @map("backout_plan")
  testPlan           String? @map("test_plan")

  plannedStartAt DateTime? @map("planned_start_at") @db.Timestamptz(6)
  plannedEndAt   DateTime? @map("planned_end_at") @db.Timestamptz(6)
  actualStartAt  DateTime? @map("actual_start_at") @db.Timestamptz(6)
  actualEndAt    DateTime? @map("actual_end_at") @db.Timestamptz(6)

  /// Why it needed no approval, when it needed none: the template it came
  /// from, or that no policy matched. An unapproved change with no reason
  /// recorded is indistinguishable from one that slipped through.
  approvalNote  String?   @map("approval_note")
  approvalRequestId String? @map("approval_request_id") @db.Uuid
  /// An emergency change owes one *afterwards*. Null until it is given.
  retrospectiveApprovedAt DateTime? @map("retrospective_approved_at") @db.Timestamptz(6)
  retrospectiveApprovedBy String? @map("retrospective_approved_by") @db.Uuid

  /// successful | successful_with_issues | backed_out | failed
  closeCode     String?   @map("close_code")
  closeNotes    String?   @map("close_notes")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  version       Int       @default(1)

  @@unique([tenantId, number])
  @@index([tenantId, status, plannedStartAt])
  @@index([tenantId, kind, status])
  @@index([tenantId, serviceId, plannedStartAt])
  @@map("change")
}

/// When changes may happen, and when they may not.
///
/// One table with a `kind` because the two are the same shape and the
/// interesting behaviour is in how they combine: a blackout beats a change
/// window, always. Two tables would invite two subtly different overlap
/// calculations, and the one that was wrong would be the one that let a change
/// through on year-end close.
model ChangeWindow {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// change | blackout
  kind       String    @default("change")
  name       String
  /// Why this blackout exists, for the person it just refused.
  reason     String?
  timeZone   String    @map("time_zone")

  /// An absolute range — a year-end freeze, a datacentre move.
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)

  /// Or a weekly one — "every Saturday 22:00 to 02:00". Local wall-clock
  /// times against a zone, not instants, because "Saturday at ten" stays true
  /// across a daylight-saving change and an instant does not (ADR-0024).
  weekday    String?
  startTime  String?   @map("start_time")
  endTime    String?   @map("end_time")

  /// Null means every service. A window scoped to a service does not restrain
  /// a change to another one.
  serviceIds String[]  @default([]) @map("service_ids")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid

  @@index([tenantId, kind, status])
  @@map("change_window")
}

/// A change that has been approved in advance, as a class.
///
/// The template is what carries the approval, so a standard change raised from
/// it needs none of its own. Versioned for the same reason every other
/// definition in this platform is: a change approved under version 3 must not
/// be answerable for what version 4 says.
model StandardChangeTemplate {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  key           String
  name          String
  description   String?
  version       Int      @default(1)
  /// draft | published | retired. Only a published template pre-approves.
  status        String   @default("draft")
  risk          String   @default("low")
  implementationPlan String? @map("implementation_plan")
  backoutPlan        String? @map("backout_plan")
  testPlan           String? @map("test_plan")
  /// Who signed it off, and when — the approval every change from it inherits.
  approvedBy    String?  @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("standard_change_template")
}

// ===========================================================================
// modules/channels/prisma/schema.prisma
// ===========================================================================

/// MOD-03 Omnichannel — the shared adapter framework (PH-2).
///
/// Email is the reference channel; Slack, Teams, WhatsApp and voice arrive in
/// PH-4 and reuse every table here (docs/architecture/07 §5). The framework
/// holds what is common to all of them: which account received the message,
/// whose identity it maps to, which conversation it belongs to, and whether it
/// has been seen before.

model ChannelAccount {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  orgId        String?  @map("org_id") @db.Uuid
  channel      String
  key          String
  name         String
  /// The mailbox, workspace or number this account receives on.
  address      String
  /// Per-channel settings: transport, signing secret reference, defaults.
  config       Json     @default("{}")
  status       String   @default("active")
  /// Health, tracked so a silently broken inbound path is visible.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  failureCount Int      @default(0) @map("failure_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities   ChannelIdentity[]
  conversations Conversation[]
  inbound      InboundMessage[]

  @@unique([tenantId, channel, key])
  @@index([tenantId, channel, status])
  @@map("channel_account")
}

/// Which person a channel address belongs to.
///
/// Verified before any ticket data is revealed: an email envelope is trivially
/// forged, so an unverified identity may only ask to be linked, never to read
/// (docs/architecture/07 §5).
model ChannelIdentity {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  channel    String
  /// Lower-cased address, handle or number as the provider reports it.
  externalId String    @map("external_id")
  userId     String?   @map("user_id") @db.Uuid
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  /// How it was verified: provider_verified, one_time_code, admin.
  method     String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account    ChannelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalId])
  @@index([tenantId, userId])
  @@map("channel_identity")
}

/// A thread on one channel about one ticket. A ticket may have several, which
/// is what makes cross-channel continuity possible.
model Conversation {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  channel          String
  ticketId         String?  @map("ticket_id") @db.Uuid
  /// The provider's thread identifier, for replying into the same thread.
  externalThreadId String?  @map("external_thread_id")
  state            Json     @default("{}")
  lastInboundAt    DateTime? @map("last_inbound_at") @db.Timestamptz(6)
  lastOutboundAt   DateTime? @map("last_outbound_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account          ChannelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalThreadId])
  @@index([tenantId, ticketId])
  @@map("conversation")
}

/// Every message the platform accepted, kept so the same provider delivery can
/// never be processed twice and so an inbound path can be replayed.
model InboundMessage {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  channel           String
  /// The provider's own message id: the idempotency key for the whole path.
  externalMessageId String   @map("external_message_id")
  fromAddress       String   @map("from_address")
  subject           String?
  body              String?
  /// The raw provider payload, redacted of secrets, for replay and support.
  raw               Json     @default("{}")
  conversationId    String?  @map("conversation_id") @db.Uuid
  ticketId          String?  @map("ticket_id") @db.Uuid
  status            String   @default("received")
  rejectedReason    String?  @map("rejected_reason")
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(6)

  account           ChannelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalMessageId])
  @@index([tenantId, status, receivedAt(sort: Desc)])
  @@index([tenantId, fromAddress, receivedAt(sort: Desc)])
  @@map("inbound_message")
}

// ===========================================================================
// modules/feedback/prisma/schema.prisma
// ===========================================================================

/// MOD-18 Feedback (PH-4).
///
/// A survey is a form (MOD-02's document shape) plus a scoring rule saying
/// which answer is the headline number and what scale it was asked on. It is
/// versioned the way a catalogue form is — a published version is immutable —
/// because a response is only meaningful against the questions that were
/// actually asked, and a survey edited on Tuesday must not make Monday's
/// answers look like they were given to Tuesday's questions.

model SurveyDefinition {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  /// The working copy: a form document plus `scoring`. Publishing snapshots it.
  document    Json      @default("{}")
  /// draft | published | retired
  status      String    @default("draft")
  version     Int       @default(0)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  versions    SurveyVersion[]
  triggers    SurveyTrigger[]

  @@unique([tenantId, key])
  @@map("survey_definition")
}

model SurveyVersion {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  version      Int
  document     Json
  publishedAt  DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy  String?  @map("published_by") @db.Uuid

  definition   SurveyDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  invitations  SurveyInvitation[]
  responses    SurveyResponse[]

  @@unique([definitionId, version])
  @@index([tenantId])
  @@map("survey_version")
}

/// When a survey goes out.
///
/// Three kinds, each an event the platform already publishes: a ticket
/// resolved, a request fulfilled (a resolved ticket of type `request`), a
/// major incident resolved. A condition narrows it — this service, that
/// priority — using the same expression language the rules engine uses, so
/// nothing here is a second way to say "priority is P1".
model SurveyTrigger {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  surveyId     String   @map("survey_id") @db.Uuid
  /// ticket.resolved | request.fulfilled | incident.major.resolved
  kind         String
  conditions   Json?
  /// No second survey to the same person inside this many days, from any
  /// trigger. The one number that decides whether people keep answering.
  throttleDays Int      @default(7) @map("throttle_days")
  /// How long the link lives.
  expiryDays   Int      @default(14) @map("expiry_days")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  survey       SurveyDefinition @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, isActive])
  @@index([tenantId, surveyId])
  @@map("survey_trigger")
}

/// One ask, to one person, about one thing.
///
/// The token is stored hashed: the link in somebody's inbox is the only copy
/// of the secret, and a database read must not be a way to answer for them.
model SurveyInvitation {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  surveyId     String    @map("survey_id") @db.Uuid
  versionId    String    @map("version_id") @db.Uuid
  triggerId    String?   @map("trigger_id") @db.Uuid
  /// What is being rated: a ticket, or an incident (through its ticket).
  ticketId     String?   @map("ticket_id") @db.Uuid
  incidentId   String?   @map("incident_id") @db.Uuid
  recipientId  String    @map("recipient_id") @db.Uuid
  /// The chat thread the ask was posted into, if one was.
  conversationId String? @map("conversation_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  /// pending | responded | expired | declined
  status       String    @default("pending")
  sentAt       DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  respondedAt  DateTime? @map("responded_at") @db.Timestamptz(6)
  /// The last channel that showed it: email, portal, slack, teams, whatsapp.
  channels     String[]  @default([])

  version      SurveyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  response     SurveyResponse?

  /// One ask per person per thing: a ticket reopened and resolved again does
  /// not earn a second survey.
  @@unique([tenantId, surveyId, ticketId, recipientId])
  @@index([tenantId, recipientId, sentAt(sort: Desc)])
  @@index([tenantId, status, expiresAt])
  @@map("survey_invitation")
}

model SurveyResponse {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  invitationId String   @unique @map("invitation_id") @db.Uuid
  surveyId     String   @map("survey_id") @db.Uuid
  versionId    String   @map("version_id") @db.Uuid
  ticketId     String?  @map("ticket_id") @db.Uuid
  respondentId String?  @map("respondent_id") @db.Uuid
  /// Every answer, keyed by field, as validated against the version shown.
  answers      Json     @default("{}")
  /// The headline answer normalised to 0-100, so two surveys on different
  /// scales are comparable. Null when the survey has no scored question.
  score        Int?
  /// The scale the headline question used, e.g. `1-5`.
  scale        String?
  comment      String?
  /// portal | email | slack | teams | whatsapp
  via          String
  respondedAt  DateTime @default(now()) @map("responded_at") @db.Timestamptz(6)

  invitation   SurveyInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  version      SurveyVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([tenantId, surveyId, respondedAt(sort: Desc)])
  @@index([tenantId, ticketId])
  @@map("survey_response")
}

