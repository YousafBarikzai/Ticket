/// The pre-aggregation that makes a year of data answerable in under a second.
///
/// One row per day, per grouping. A year of a busy tenant is a few thousand
/// rows here against a million in `fact_ticket`, which is the difference
/// between a dashboard that loads and one somebody stops opening.
///
/// Maintained incrementally as facts are written and rebuilt nightly, because
/// an incremental count drifts — an event replayed, a fact corrected — and a
/// rollup nobody rebuilds is a rollup that is quietly wrong by March.
model RollupTicketDaily {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  date        DateTime @db.Date
  /// The grouping, spelled out: `all`, `team:<id>`, `service:<id>|priority:P1`.
  ///
  /// The unique key is this string rather than the three nullable columns
  /// below, because PostgreSQL treats NULLs in a unique index as distinct from
  /// one another: `(tenant, date, NULL, NULL, NULL)` would not conflict with
  /// itself, so the "all" row would silently duplicate on every upsert and
  /// every total would climb. The columns stay for filtering and grouping.
  groupingKey String   @map("grouping_key")
  /// Null means "all", so one table answers both the totals and the breakdown
  /// without a second query or a union.
  teamId      String?  @map("team_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  priority    String?

  created     Int      @default(0)
  resolved    Int      @default(0)
  closed      Int      @default(0)
  reopened    Int      @default(0)
  breached    Int      @default(0)
  /// Sum and count rather than a stored mean: averages do not add up, and a
  /// weekly figure built from seven daily means is wrong in a way nobody spots.
  resolveMinutesSum   Int @default(0) @map("resolve_minutes_sum")
  resolveMinutesCount Int @default(0) @map("resolve_minutes_count")
  firstResponseMinutesSum   Int @default(0) @map("first_response_minutes_sum")
  firstResponseMinutesCount Int @default(0) @map("first_response_minutes_count")

  rebuiltAt   DateTime @default(now()) @map("rebuilt_at") @db.Timestamptz(6)

  @@unique([tenantId, date, groupingKey])
  @@index([tenantId, date])
  @@index([tenantId, teamId, date])
  @@index([tenantId, serviceId, date])
  @@map("rollup_ticket_daily")
}

/// What a projector has already seen.
///
/// The inbox for the analytics consumer. A projection that is not idempotent
/// double-counts on any redelivery, and the outbox guarantees at-least-once
/// rather than exactly-once — so this is what turns one into the other.
model ProjectionCursor {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projector   String
  lastEventId String?  @map("last_event_id") @db.Uuid
  lastEventAt DateTime? @map("last_event_at") @db.Timestamptz(6)
  processed   BigInt   @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, projector])
  @@map("projection_cursor")
}

/// A recorded disagreement between the facts and the truth.
///
/// Kept rather than only alerted: "the projection was 0.8 % light for three
/// days in March" is a thing somebody needs to be able to look up when a
/// quarterly number is questioned, and an alert that has scrolled away cannot
/// answer it.
model ProjectionDrift {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  checkedAt  DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  projector  String
  /// What the owning module says, asked through its own service.
  expected   Int
  /// What the fact table holds.
  actual     Int
  driftRatio Float    @map("drift_ratio")
  resolved   Boolean  @default(false)

  @@index([tenantId, checkedAt])
  @@index([tenantId, resolved, checkedAt])
  @@map("projection_drift")
}

